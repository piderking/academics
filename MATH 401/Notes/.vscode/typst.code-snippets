	"Infinite Summation": {
		"prefix": "infsum",
		"scope": "typst",
		"body": "sum_(n=$1)^oo $2"
	},
	"Infinite Limit": {
		"prefix": "inflim",
		"scope": "typst",
		"body": "lim_($1->oo) $2"
	},
	"Infinite Integral": {
		"prefix": "infintegral",
		"scope": "typst",
		"body": "lim_($1->oo) integral_($2)^($1) $3 d x"
	},
	"Definite Integral": {
		"prefix": "definiteintegral",
		"scope": "typst",
		"body": "integral_($1)^($2) $3 d x"
	},
	"Exponential": {
		"prefix": "exp",
		"scope": "typst",
		"body": "($1)^($2)"
	},
	"Logarithm": {
		"prefix": "log",
		"scope": "typst",
		"body": "log_($1)($2)"
	},
	"Derrivative": {
		"prefix": "derrivative",
		"scope": "typst",
		"body": "d/(d $1)($2)"
	}
}