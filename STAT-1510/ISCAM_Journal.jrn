ButtonBox(title("Confidence Interval for One Proportion"),scriptText("/*\!r\!nConfidenceIntervalForProportion.jsl\!r\!n\!r\!n14 Feb 2013\!r\!n\!r\!nCopyright (c) 2013 by SAS Institute Inc., Cary, NC 27513, USA. All rights reserved.\!r\!n\!r\!nNote: please read the disclaimer at the end of this script.\!r\!n\!r\!nPurpose\!r\!nThis script constructs confidence intervals for the population proportion using raw data or summary statistics.\!r\!n\!r\!nAuthor\!r\!nBrady Brady (SAS Institute)\!r\!n\!r\!n*/\!r\!n\!r\!nClear Globals();\!r\!nNames Default To Here( 1 );\!r\!n\!r\!ngethistprop = function({x, n, suc},\!r\!n\!t// takes x, n and a string naming success and returns a histogram of sample proportions\!r\!n\!t{dtnew, l, dis, pic},\!r\!n\!tdtnew = newtable(\!"x\!", <<invisible);\!r\!n\!tdtnew << addrows(n);\!r\!n\!tcolumn(dtnew, 1)<<datatype(\!"Character\!");\!r\!n\!tcolumn(dtnew, 1)<<set formula(if(row()>x, \!r\!n\!t\!tif(suc == \!"Success\!", \!"Failure\!", \!"Other\!")\!r\!n\!t\!t,\!r\!n\!t\!tsuc));\!r\!n\!tl = evallist(if(suc==\!"Success\!", {\!"Success\!", \!"Failure\!"}, {suc, \!"Not \!"||suc}));\!r\!n\!tcolumn(dtnew, 1)<<set property(\!"value ordering\!", l);\!r\!n\!tdis = dtnew << Distribution(\!r\!n\!t\!tStack( 1 ),\!r\!n\!t\!tNominal Distribution(\!r\!n\!t\!t\!tColumn( :Column 1 ),\!r\!n\!t\!t\!tHorizontal Layout( 1 ),\!r\!n\!t\!t\!tcount axis(1),\!r\!n\!t\!t\!taxes on left(1),\!r\!n\!t\!t\!tshow percents(1),\!r\!n\!t\!t\!tVertical( 0 ),\!r\!n\!t\!t\!tSeparate Bars( 1 )\!r\!n\!t\!t),\!r\!n\!t\!tinvisible\!r\!n\!t);\!r\!n\!r\!n\!tpic = report(dis)[listbox(4)]<<getpicture;\!r\!n\!tclose(dtnew, nosave);\!r\!n\!tpic;\!r\!n);\!r\!n\!r\!nRunRawData = Expr(\!r\!n// User Functions\!r\!n\!r\!ngetFrequency = Function( {inList, sString},\!r\!n\!t{Default Local},\!r\!n\!tn = N Items( inList );\!r\!n\!tfrequency = 0;\!r\!n\!tFor( i = 1, i <= n, i++,\!r\!n\!t\!tIf( inList[i] == sString,\!r\!n\!t\!t\!tfrequency += 1\!r\!n\!t\!t)\!r\!n\!t);\!r\!n\!tfrequency;\!r\!n);\!r\!n\!r\!n\!r\!n\!r\!ncalcNecessaryStatistics = Function( {dt},\!r\!n\!t{Default Local},\!r\!n\!tIf( Is Empty( dt ),\!r\!n\!t\!tTry( dt = Open() );\!r\!n\!t\!tIf( Is Empty( dt ),\!r\!n\!t\!t\!tNew Window( ,\!r\!n\!t\!t\!t\!tmodal,\!r\!n\!t\!t\!t\!tText Box( \!r\!n\!t\!t\!t\!t\!t\!"No Data Table Selected. Script Terminating.\!" \!r\!n\!t\!t\!t\!t)\!r\!n\!t\!t\!t);\!r\!n\!t\!t\!tstop();\!r\!n\!t\!t);\!r\!n\!t);\!r\!n\!tnc = N Col( dt );\!r\!n\!tIf( nc == 1,\!r\!n\!t\!tm = Column( 1 ) << get values;\!r\!n\!t\!tres = Dialog(\!r\!n\!t\!t\!t\!"\!",\!r\!n\!t\!t\!tHList( \!"Value Associated with a Success\!", ex = EditText( \!"Success\!" ) )\!r\!n\!t\!t);\!r\!n\!t\!tIf( res[\!"button\!"] == 1,\!r\!n\!t\!t\!tsuccessString = res[\!"ex\!"],\!r\!n\!t\!t\!tNew Window( ,\!r\!n\!t\!t\!t\!tmodal,\!r\!n\!t\!t\!t\!tText Box( \!"No Column Selected. Script Terminating.\!" )\!r\!n\!t\!t\!t);\!r\!n\!t\!t\!tStop();\!r\!n\!t\!t);\!r\!n\!t,\!r\!n\!t\!tres = Column Dialog(\!r\!n\!t\!t\!tc = ColList( \!"Pick a Column\!", Min Col(1), Max Col( 1 ) ),\!r\!n\!t\!t\!tHList( \!"Value Associated with a Success\!", ex = EditText( \!"Success\!" ) )\!r\!n\!t\!t);\!r\!n\!t\!tIf( res[\!"button\!"] == 1,\!r\!n\!t\!t\!tm = res[\!"c\!"][1] << get values;\!r\!n\!t\!t\!tsuccessString = res[\!"ex\!"];\!r\!n\!t\!t,\!r\!n\!t\!t\!tNew Window( ,\!r\!n\!t\!t\!t\!tmodal,\!r\!n\!t\!t\!t\!tText Box( \!"No Column Selected. Script Terminating.\!" )\!r\!n\!t\!t\!t);\!r\!n\!t\!t\!tStop();\!r\!n\!t\!t);\!r\!n\!t);\!r\!n\!tIf( Is List( m ), \!r\!n\!t//Nominal Variable\!r\!n\!t\!tx = getFrequency( m, successString );\!r\!n\!t\!tn = N Items( m );\!r\!n\!t\!tnmiss = N Missing( m );\!r\!n\!t\!tn -= nmiss;\!r\!n\!t, \!r\!n\!t//Continuous Variable\!r\!n\!t\!tn = N Row( m );\!r\!n\!t\!tinList = {};\!r\!n\!t\!tFor( i = 1, i <= n, i++,\!r\!n\!t\!t\!tinList[i] = Char( m[i] )\!r\!n\!t\!t);\!r\!n\!t\!tx = getFrequency( inList, successString );\!r\!n\!t\!tnmiss = N Missing( m );\!r\!n\!t\!tn -= nmiss;\!r\!n\!t);\!r\!n\!tEval List( {x, n, successString} );\!r\!n);\!r\!n\!r\!nevalSummary = Function( {x, n, alpha},\!r\!n\!t{Default Local},\!r\!n\!tz = Normal Quantile( 1 - (1 - alpha) / 2 );\!r\!n\!tp = x / n;\!r\!n\!tse = Sqrt( p * (1 - p) / n );\!r\!n\!tIf( x == 0,\!r\!n\!t\!tlower = 0;\!r\!n\!t\!tupper = 1 - (1 - alpha) ^ (1 / n);\!r\!n\!t);\!r\!n\!tIf( x == n,\!r\!n\!t\!tlower = (1 - alpha) ^ (1 / n);\!r\!n\!t\!tupper = 1;\!r\!n\!t);\!r\!n\!tIf( x != 0 & x != n,\!r\!n\!t\!tlower = p - z * se;\!r\!n\!t\!tupper = p + z * se;\!r\!n\!t\!tIf( lower < 0, lower = 0 );\!r\!n\!t\!tIf( upper > 1, upper = 1 );\!r\!n\!t);\!r\!n\!tEval List( {p, lower, upper} );\!r\!n);\!r\!n\!r\!nchangeInference = Function( {obInference, gb, x, n, alpha},\!r\!n\!t{p, lower, upper} = evalSummary( x, n, alpha );\!r\!n\!tvlbInference << Delete;\!r\!n\!tobInference << Append(\!r\!n\!t\!tvlbInference = V List Box(\!r\!n\!t\!t\!tTable Box(\!r\!n\!t\!t\!t\!tString Col Box( \!"Result\!",\!r\!n\!t\!t\!t\!t\!t{\!"Estimated Proportion\!", \!"Lower Limit\!", \!"Upper Limit\!"}, \!r\!n\!r\!n\!t\!t\!t\!t),\!r\!n\!t\!t\!t\!tNumber Col Box( \!"Value\!", p || lower || upper )\!r\!n\!t\!t\!t)\!r\!n\!t\!t)\!r\!n\!t);\!r\!n\!tgb << reshow;\!r\!n);\!r\!n\!r\!ndt = Current Data Table();\!r\!nalpha = 0.95;\!r\!n{x, n, sucstr} = calcNecessaryStatistics( dt );\!r\!n{p, lower, upper} = evalSummary( x, n, alpha );\!r\!n\!r\!nNew Window( \!"CI for Proportion from Data\!",\!r\!n\!tV List Box(\!r\!n\!t\!tOutline Box( \!"Sample Statistics\!",\!r\!n\!t\!t\!tv listbox(\!r\!n\!t\!t\!t\!thlistbox(\!r\!n\!t\!t\!t\!t\!thcenterbox(\!r\!n\!t\!t\!t\!t\!t\!tgethistprop(x, n, sucstr)\!r\!n\!t\!t\!t\!t\!t)\!r\!n\!t\!t\!t\!t),\!r\!n\!t\!t\!t\!thcenterbox(\!r\!n\!t\!t\!t\!t\!tTable Box(\!r\!n\!t\!t\!t\!t\!t\!tString Col Box( \!"\!", {\!"Number of Successes\!", \!"Sample Size\!"} ),\!r\!n\!t\!t\!t\!t\!t\!tNumber Col Box( \!"\!", {x, n} )\!r\!n\!t\!t\!t\!t\!t)\!r\!n\!t\!t\!t\!t)\!r\!n\!t\!t\!t)\!r\!n\!t\!t),\!r\!n\!t\!thcenterbox(\!r\!n\!t\!t\!tobInference = Outline Box( \!"Conf