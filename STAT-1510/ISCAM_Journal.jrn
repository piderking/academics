Col Box( ,\!r\!n\!t\!t\!t\!tresultsLabels\!r\!n\!t\!t\!t),\!r\!n\!t\!t\!tNumber Col Box( ,\!r\!n\!t\!t\!t\!tJ( 2, 1, . )\!r\!n\!t\!t\!t)\!r\!n\!t\!t)\!r\!n\!t);\!r\!n\!tevalInputs;\!r\!n);\!r\!n\!r\!nevalInputs = Expr(\!r\!n\!t// check specific array for missing values, else proceed\!r\!n\!tIf( Not( Sum( Is Missing( parmVal ) ) ),\!r\!n\!t\!t// confidence interval\!r\!n\!t\!tresult = J( 2, 1, . );\!r\!n\!t\!talpha = 1-parmval[1];\!r\!n\!t\!tp = parmval[2];\!r\!n\!t\!tSE = parmVal[3];\!r\!n\!t\!tz = Normal Quantile(1-alpha/2);\!r\!n\!t\!tntheoretical = p*(1-p)*(z/SE)^2;\!r\!n\!t\!tnpractical = ceiling(ntheoretical);\!r\!n\!t\!tresult = ntheoretical|| npractical;\!r\!n\!t\!thlbResults[NumberColBox(1)] << Set Values( result );\!r\!n\!t);\!r\!n);\!r\!n\!r\!n// user functions\!r\!n\!r\!nuseParm = Function( { p, v },\!r\!n\!tIf( checkParm( p, v ),\!r\!n\!t\!tparmVal[p] = v;\!r\!n\!t\!tevalInputs,\!r\!n\!t\!tvlbInputs[TextEditBox(p)] << Set Text( Char( parmVal[p] ) );\!r\!n\!t);\!r\!n);\!r\!n\!r\!ncheckParm = Function( { p, v },\!r\!n\!tIf( Not( Is Missing( v ) ),\!r\!n\!t\!tChoose( p,\!r\!n\!t\!t\!t// confidence level\!r\!n\!t\!t\!t0 < v < 1,\!r\!n\!t\!t\!t// expected proportion\!r\!n\!t\!t\!t0 < v < 1,\!r\!n\!t\!t\!t// Margin of error\!r\!n\!t\!t\!tv < 0.5\!r\!n\!t\!t)\!r\!n\!t,\!r\!n\!t\!t0;\!r\!n\!t);\!r\!n);\!r\!n\!r\!n// present application\!r\!n\!r\!nNew Window( \!"Sample Size Determination\!",\!r\!n\!tV List Box(\!r\!n\!t\!tOutline Box(\!"Sample Size for Estimation of the Proportion\!", \!r\!n\!t\!t\!tobInputs = Outline Box( \!"Inputs\!",\!r\!n\!t\!t\!t\!tvlbInputs = V List Box(\!r\!n\!t\!t\!t\!t)\!r\!n\!t\!t\!t),\!r\!n\!t\!t\!tobResults = Outline Box( \!"Results\!",\!r\!n\!t\!t\!t\!thlbResults = V List Box(\!r\!n\!t\!t\!t\!t)\!r\!n\!t\!t\!t),\!r\!n\!t\!t\!tText box (\!" \!"\!r\!n\!t\!t\!t)\!r\!n\!t\!t)\!r\!n\!t)\!r\!n);\!r\!n\!r\!n\!r\!n// get it rolling\!r\!n\!r\!nchangeInputs;\!r\!nchangeResults;\!r\!n\!t\!r\!n);\!r\!n//******************************************