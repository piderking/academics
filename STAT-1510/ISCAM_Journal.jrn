1;\!r\!n\!t\!t\!tresult[6] = sediff = sqrt(se1^2 + se2^2);\!r\!n\!t\!t\!tresult[7] = z = normalquantile(1-alpha/2);\!r\!n\!t\!t\!tresult[8] = max(-1, diff - z*sediff);\!r\!n\!t\!t\!tresult[9] = min(1, diff + z*sediff);\!r\!n\!t\!t);\!r\!n\!t\!tevallist({stats, round(result, 4)})\!r\!n\!t);\!r\!n\!r\!n\!tupdateResults = function({stats, result},\!r\!n\!t\!t{stats,result} = computeResults(stats, result);\!r\!n\!t\!tIf(all(!ismissing((result))),\!r\!n\!t\!t\!ttry(civlb<<delete);\!t\!t\!t\!t\!r\!n\!t\!t\!tciolb << append(\!r\!n\!t\!t\!t\!tcivlb = vlistbox(\!r\!n\!t\!t\!t\!t\!ttablebox(\!r\!n\!t\!t\!t\!t\!t\!tstringcolbox(\!"Result\!", resulttext),\!r\!n\!t\!t\!t\!t\!t\!tresncb = numbercolbox(\!"Value\!", result)\!r\!n\!t\!t\!t\!t\!t),\!r\!n\!t\!t\!t\!t\!thcenterbox(\!r\!n\!t\!t\!t\!t\!t\!tgb = Graph Box(\!r\!n\!t\!t\!t\!t\!t\!t\!t\!tFrame Size( 250, 50 ),\!r\!n\!t\!t\!t\!t\!t\!t\!t\!tX Name( \!"p2 - p1\!" ),\!r\!n\!t\!t\!t\!t\!t\!t\!t\!txscale (-1, 1),\!r\!n\!t\!t\!t\!t\!t\!t\!t\!tPen Color( \!"red\!" );\!r\!n\!t\!t\!t\!t\!t\!t\!t\!tH Line( result[8], result[9], 40 ); // interval\!r\!n\!t\!t\!t\!t\!t\!t\!t\!tV Line( result[8], 30, 50 ); // right end\!r\!n\!t\!t\!t\!t\!t\!t\!t\!tV Line( result[9], 30, 50 ); // left end\!r\!n\!t\!t\!t\!t\!t\!t\!t\!tPen Color(\!"blue\!");\!r\!n\!t\!t\!t\!t\!t\!t\!t\!tV Line((result[8]+result[9])/2, 30, 50)\!r\!n\!t\!t\!t\!t\!t\!t)\!r\!n\!t\!t\!t\!t\!t)\!r\!n\!t\!t\!t\!t)\!r\!n\!t\!t\!t);\!r\!n\!t\!t\!tplotCleanup;\!r\!n\!t\!t);\!r\!n\!t\!tevallist({stats, result})\!r\!n\!t);\!r\!n\!r\!n\!tplotCleanup = Expr(\!r\!n\!t\!tgb[AxisBox(1)]\!r\!n\!t\!t\!t<< Remove Axis Label\!r\!n\!t\!t\!t<< Show Major Ticks( 0 )\!r\!n\!t\!t\!t<< Show Labels( 0 )\!r\!n\!t\!t\!t<< Show Minor Ticks( 0 );\!r\!n\!t\!tgb[AxisBox(2)]\!r\!n\!t\!t\!t<< Format( \!"Fixed Dec\!", 6, 3);\!r\!n\!t);\!r\!n\!r\!n\!tmsg = function({t, s},\!r\!n\!t\!tnewwindow(t, modal, textbox(\!"\!\!N\!"||s||\!"\!\!N\!", << set wrap(800)))\!r\!n\!t);\!r\!n\!r\!n\!tshowwin = expr(\!r\!n\!t\!tnew