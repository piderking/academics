ButtonBox(title("Confidence Interval for Two Means"),scriptText("/*\!r\!nDate: 12 Sept 2016\!r\!n\!r\!nCopyright (c) 2016 by SAS Institute Inc., Cary, NC 27513, USA. All rights reserved.\!r\!n\!r\!nNote: please read the disclaimer at the end of this script.\!r\!n\!r\!nPurpose: This script computes a confidence interval for the difference of two means.\!r\!n\!r\!nAuthor:\!r\!nBrady Brady (SAS Institute)\!r\!n\!r\!n*/\!r\!n\!r\!n\!r\!nnamesdefaulttohere(1);\!r\!nclear globals();\!r\!n\!r\!n\!r\!n\!r\!nfromData = expr(\!r\!n\!r\!n\!tinitVars = expr(\!r\!n\!tfirstplot = 1;\!r\!n\!txlo = 0;\!r\!n\!txhi = 1;\!r\!n\!tsig1 = sig2 = 1;\!r\!n\!tconf = 0.95;\!r\!n\!tdomainErrTxt = \!"\!\!NDomain error:\!\!N\!\!NKnown sigmas must be positive.\!\!N\!\!NConfidence must be between 0 and 1, exclusive.\!\!N\!\!NResetting values.\!";\!r\!n\!tsummarytext = {\!"Sample 1 Mean\!", \!"Sample 1 Std. Dev.\!", \!"Sample 1 Size\!", \!"Sample 2 Mean\!", \!"Sample 2 Std. Dev.\!", \!"Sample 2 Size\!"};\!r\!n\!tresulttext = {{\!"Mean 2 - Mean 1\!", \!"Pooled Std Dev\!", \!"Degrees of Freedom\!", \!"z multiplier\!", \!"Std Dev of Difference in Means\!", \!"Lower Limit\!", \!"Upper Limit\!"},\!r\!n\!t\!t\!t\!t\!t{\!"Mean 2 - Mean 1\!", \!"Pooled Std Dev\!", \!"Degrees of Freedom\!", \!"t multiplier\!", \!"Std Dev of Difference in Means\!", \!"Lower Limit\!", \!"Upper Limit\!"}};\!r\!n\!tresult = J(7,1,.);\!r\!n\!t);\!r\!n\!tinitVars;\!r\!n\!r\!n\!tcalcNecessaryStatistics = Function( {dt},\!r\!n\!t\!t{Default Local},\!r\!n\!t\!tIf( Is Empty( dt ),\!r\!n\!t\!t\!tTry( dt = Open() );\!r\!n\!t\!t\!tIf( Is Empty( dt ),\!r\!n\!t\!t\!t\!tmsg(\!"Error!\!", \!"No Data Table Selected. Script Terminating.\!");\!r\!n\!t\!t\!t\!tstop();\!r\!n\!t\!t\!t);\!r\!n\!t\!t);\!r\!n\!t\!tnc = N Col( dt );\!r\!n\!t\!tIf( nc > 1,\!r\!n\!t\!t\!tres = Column Dialog(\!r\!n\!t\!t\!t\!tc1 = ColList( \!"Pick a Column Containing the Names of the 2 Groups\!", Min Col(1), Max Col( 1 ) ),\!r\!n\!t\!t\!t\!tc2 = ColList( \!"Pick a Colu