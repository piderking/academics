ButtonBox(title("Hypothesis Test for Two Proportions"),scriptText("/*\!r\!nTestTwoSampleProportions.jsl\!r\!n\!r\!n14 Feb 2013\!r\!n\!r\!nCopyright (c) 2013 by SAS Institute Inc., Cary, NC 27513, USA. All rights reserved.\!r\!n\!r\!nNote: please read the disclaimer at the end of this script.\!r\!n\!r\!nPurpose\!r\!nThis script performs a hypothesis test on two sample proportions using raw data or summary statistics.\!r\!n\!r\!nAuthor\!r\!nBrady Brady (SAS Institute)\!r\!n\!r\!n*/\!r\!n\!r\!nClear Globals();\!r\!nNames Default To Here( 1 );\!r\!n\!r\!n\!r\!nRunRawData = Expr(\!r\!n\!r\!ninferencetextlist = {\!"Reject Null Hypothesis\!", \!"Fail to Reject Null Hypothesis\!"};\!r\!ninferencelabels = {\!"z-score\!", \!"z Critical Values\!", \!"Observed Significance (p-value)\!"};\!r\!nparmStr = List( \!"Hypothesized Difference (p2-p1)\!", \!"Significance Level (alpha)\!" );\!r\!nsummaryLabels = {\!"Sample 1 Successes\!", \!"Sample 1 Size\!", \!"Sample 2 Successes\!", \!"Sample 2 Size\!", \!"Sample 1 Proportion\!", \!"Sample 2 Proportion\!", \!"Pooled Proportion\!", \!"Difference in Sample Proportions (p2-p1)\!"}; \!r\!ninferText = \!" \!";\!r\!nresult = {\!".\!", \!".\!", \!".\!"};\!r\!nparmVal = Eval List( J( 2, 1, . ) );\!r\!nparmVal[1] = 0; ParmVal[2] = 0.05;\!r\!nAlternative = 1;\!r\!nvarOpts = 1;\!r\!n\!r\!n\!r\!n// macros\!r\!n\!r\!nchangeSummary = Expr(\!r\!n\!tvlbSummary << Delete;\!r\!n\!tlineUpBoxExpr = Expr( Lineup Box( N Col( 2 ) ) );\!r\!n\!tnParms = 2;\!r\!n\!t\!r\!n\!tFor( i = 1, i <= nParms, i++,\!r\!n\!t\!tInsert Into( lineUpBoxExpr, Parse( Substitute( \!"Text Box( parmStr[iii] )\!", \!"iii\!", Char( i ) ) ) );\!r\!n\!t\!tInsert Into(\!r\!n\!t\!t\!tlineUpBoxExpr,\!r\!n\!t\!t\!tParse(\!r\!n\!t\!t\!t\!tSubstitute(\!r\!n\!t\!t\!t\!t\!t\!t\!"tebiii = Text Edit Box( parmVal[iii],\!r\!n\!t\!t\!t\!t\!t\!t<< Script(\!r\!n\!t\!t\!t\!t\!t\!t\!tuseParm(\!r\!n\!t\!t\!t\!t\!t\!t\!t\!talternative,\!r\!n\!t\!t\!t\!t\!t\!t\!t\!tiii,\!r\!n\!t\!t\!t\!t\!t\!t\!t\!tNum( tebiii << Get Text )\!r\!n\!t\!t\!t\!t\!t\!t\!t)\!r\!n\!t\!t\!t\!t\!t\!t)\!r\!n\!t\!t\!t\!t\!t)\!",\!r\!n\!t\!t\!t\!t\!t\!"iii\!", Char( i )\!r\!n\!t\!t\!t\!t)\!r\!n\!t\!t\!t)\!r\!n\!t\!t);\!r\!n\!t);\!r\!n\!r\!n\!tEval(\!r\!n\!t\!tSubstitute( Expr( obSummary << Append( vlbSummary = V List Box( iii ) ) ),\!r\!n\!t\!t\!tExpr( iii ), Name Expr( lineUpBoxExpr )\!r\!n\!t\!t)\!r\!n\!t);\!r\!n);\!r\!n\!r\!nevalSummary = Expr(\!r\!n\!t// check specific array for missing values, else proceed\!r\!n\!tIf( Not( Sum( Is Missing( parmVal ) ) ),\!r\!n\!t\!tTry( tbinference << delete );\!r\!n\!t\!tTry( tbdecision << delete );\!r\!n\!t\!t// compute test results\!r\!n\!t\!tresult = {\!".\!", \!".\!", \!".\!"};\!r\!n\!t\!tChoose( 1, \!r\!n\!t\!t\!t// z test\!r\!n\!t\!t\!thyp = parmVal[1];\!r\!n\!t\!t\!talpha = parmVal[2];\!r\!n\!t\!t\!tsignal = phat2-phat1-hyp;\!r\!n\!t\!t\!tnoise = sqrt(Choose(varOpts,\!r\!n\!t\!t\!t\!t// Pooled variance\!r\!n\!t\!t\!t\!tphatpool*(1-phatpool)/n1 + phatpool*(1-phatpool)/n2,\!r\!n\!t\!t\!t\!t// Don't pool\!r\!n\!t\!t\!t\!tphat1*(1-phat1)/n1 + phat2*(1-phat2)/n2 )\!r\!n\!t\!t\!t);\!r\!n\!t\!t\!tteststat = signal / noise;\!r\!n\!t\!t\!tresult[1] = Char( Round( teststat, 4 ) );\!r\!n\!t\!t\!tChoose( alternative,\!r\!n\!t\!t\!t\!tq = Normal Quantile( 1 - (alpha) / 2 );\!r\!n\!t\!t\!t\!tresult[2] = \!"+/- \!" || Char( Round( q, 4 ) );\!r\!n\!t\!t\!t\!tpval = 2 * (1 - Normal Distribution( Abs( Num( result[1] ) ) ));,\!r\!n\!t\!t\!t\!tq = -Normal Quantile( 1 - alpha );\!r\!n\!t\!t\!t\!tresult[2] = Char( Round( q, 4 ) );\!r\!n\!t\!t\!t\!tpval = Normal Distribution( Num( result[1] ) );,\!r\!n\!t\!t\!t\!tq = Normal Quantile( 1 - alpha );\!r\!n\!t\!t\!t\!tresult[2] = Char( Round( q, 4 ) );\!r\!n\!t\!t\!t\!tpval = 1 - Normal Distribution( Num( result[1] ) );\!r\!n\!t\!t\!t);, \!r\!n\!t\!t);\!r\!n\!t\!tresult[3] = Char( format( pval, \!"pvalue\!", 6 ) );\!r\!n\!t\!tIf( pval <= alpha,\!r\!n\!t\!t\!tinferText = inferencetextlist[1],\!r\!n\!t\!t\!tinferText = inferencetextlist[2]\!r\!n\!t\!t);\!r\!n\!t\!tresultvlb << Append(\!r\!n\!t\!t\!ttbInference = Table Box(\!r\!n\!t\!t\!t\!tString Col Box( \!"Result\!", inferenceLabels ),\!r\!n\!t\!t\!t\!tString Col Box( \!"Value\!", result )\!r\!n\!t\!t\!t)\!r\!n\!t\!t);\!r\!n\!t\!trdob << append( tbdecision = Text Box( inferText ) );\!r\!n\!t\!ttbdecision << font color(\!"Red\!");\!t\!t\!t\!t\!t\!t\!r\!n\!t)\!r\!n);\!r\!n\!r\!n// user functions\!r\!n\!r\!ncalcNecessaryStatistics = Function( {dt},\!r\!n\!t{Default Local},\!r\!n\!tIf( Is Empty( dt ),\!r\!n\!t\!tTry( dt = Open() );\!r\!n\!t\!tIf( Is Empty( dt ),\!r\!n\!t\!t\!tNew Window( ,\!r\!n\!t\!t\!t\!tmodal,\!r\!n\!t\!t\!t\!tText Box( \!r\!n\!t\!t\!t\!t\!t\!"No Data Table Selected. Script Terminating.\!" \!r\!n\!t\!t\!t\!t)\!r\!n\!t\!t\!t);\!r\!n\!t\!t\!tstop();\!r\!n\!t\!t);\!r\!n\!t);\!r\!n\!tnc = N Col( dt );\!r\!n\!tIf( nc == 1,\!r\!n\!t\!tm = Column( 1 ) << get values;\!r\!n\!t\!tres = Dialog( \!"\!", HList( \!"Value Associated with a Success\!", ex = EditText( \!"Success\!" ) ) );\!r\!n\!t\!tIf( res[\!"button\!"] == 1,\!r\!n\!t\!t\!tsuccessString = res[\!"ex\!"],\!r\!n\!t\!t\!tm = J( 0, 0, 0 )\!r\!n\!t\!t);\!r\!n\!t,\!r\!n\!t\!tres = Column Dialog(\!r\!n\!t\!t\!tc1 = ColList( \!"Pick a Column Containing the Names of the 2 Groups\!", Max Col( 1 ), Min Col(1) ),\!r\!n\!t\!t\!tc2 = ColList( \!"Pick a Column Containing the Result of Each Individual Trial\!", Max Col( 1 ), Min Col(1) ),\!r\!n\!t\!t\!tHList( \!"Enter the Value Associated with a Success\!", ex = EditText( \!"Success\!" ) )\!r\!n\!t\!t);\!r\!n\!t\!tIf( res[\!"button\!"] == 1,\!r\!n\!t\!t\!tm = res[\!"c2\!"][1] << get values;\!r\!n\!t\!t\!tsuccessString = res[\!"ex\!"];\!r\!n\!t\!t,\!r\!n\!t\!t\!tNew Window( , modal,\!r\!n\!t\!t\!t\!tText Box(\!"No Column Selected. Script Terminating.\!")\!r\!n\!t\!t\!t);\!r\!n\!t\!t\!tstop();\!r\!n\!t\!t);\!r\!n\!t);\!r\!n\!tIf (! islist(m),\!r\!n\!t\!t// numeric values\!r\!n\!t\!tsuccessString = num(SuccessString);\!r\!n\!t);\!r\!n\!tdt << clear row states;\!r\!n\!tSummarize( \!r\!n\!t\!tl = by( res[\!"c1\!"][1]),\!r\!n\!t\!tcn = count\!r\!n\!t);\!r\!n\!tdt << select where (eval(res[\!"c2\!"][1])== successString) << exclude;\!r\!n\!tSummarize(\!r\!n\!t\!tl = by( res[\!"c1\!"][1]),\!r\!n\!t\!tcx = count; // Counts Failures\!r\!n\!t);\!r\!n\!tcx = cn - cx;   // Reverts to successes\!r\!n\!tdt << clear row states;\!r\!n\!tx1 = cx[1,1]; \!r\!n\!tx2 = cx[2,1];\!r\!n\!tn1 = cn[1,1];\!r\!n\!tn2 = cn[2,1];\!r\!n\!tphat1 = x1/n1;\!r\!n\!tphat2 = x2/n2;\!r\!n\!tphatpool = (x1+x2)/(n1+n2);\!r\!n\!tdiff = phat2-phat1;\!r\!n\!tEval List({x1, x2, n1, n2, phat1, phat2, phatpool, diff});\!r\!n);\!r\!n\!r\!nuseParm = Function( {a, p, v},\!r\!n\!tIf( checkParm( a, p, v ),\!r\!n\!t\!tparmVal[p] = v;\!r\!n\!t\!tevalSummary;\!r\!n\!t,\!r\!n\!t\!tvlbSummary[Text Edit Box( p )] << Set Text( Char( parmVal[p] ) )\!r\!n\!t)\!r\!n);\!r\!n\!r\!ncheckParm = Function( {a, p, v},\!r\!n\!tIf( Not( Is Missing( v ) ),\!r\!n\!t\!tChoose( p, \!r\!n\!t\!t\!t// Hyp Diffference\!r\!n\!t\!t\!t-1 < v < 1, \!r\!n\!t\!t\!t// Significance Level\!r\!n\!t\!t\!t0 < v < 1\!r\!n\!t\!t) \!r\!n\!t,\!r\!n\!t\!t0\!r\!n\!t)\!r\!n);\!r\!n\!r\!n// present application\!r\!n\!r\!ndt = Current Data Table();\!r\!n{x1, x2, n1, n2, phat1, phat2, phatpool, diff} = calcNecessaryStatistics( dt );\!r\!n\!r\!nNew Window( \!"Z-Test on Proportions of Two Independent Samples\!",\!r\!n\!tH List Box(\!r\!n\!t\!tV List Box(\!r\!n\!t\!t\!tOutline Box( \!"Choose Type of Alternative Hypothesis\!",\!r\!n\!t\!t\!t\!trbalternative = Radio Box(\!r\!n\!t\!t\!t\!t\!t{\!"(p2-p1) not equal to the hypothesized difference (two-tailed)\!",\!r\!n\!t\!t\!t\!t\!t\!"(p2-p1) is less than the hypothesized difference (one-tailed)\!",\!r\!n\!t\!t\!t\!t\!t\!"(p2-p1) is greater than the hypothesized difference (one-tailed)\!"},\!r\!n\!t\!t\!t\!t\!t<<Script(\!r\!n\!t\!t\!t\!t\!t\!talternative = rbalternative << get;\!r\!n\!t\!t\!t\!t\!t\!tevalsummary;\!r\!n\!t\!t\!t\!t\!t)\!r\!n\!t\!t\!t\!t)\!r\!n\!t\!t\!t),\!r\!n\!t\!t\!tText Box( \!" \!" ),\!r\!n\!t\!t\!tOutline Box(\!"Choose Variance Option\!",\!r\!n\!t\!t\!t\!trbVarOpts = Radio Box(\!r\!n\!t\!t\!t\!t\!t{\!"Use Pooled Estimate of Variance\!",\!r\!n\!t\!t\!t\!t\!t\!"Do Not Use Pooled Estimate of Variance\!"},\!r\!n\!t\!t\!t\!t\!t<<Script(\!r\!n\!t\!t\!t\!t\!t\!tVarOpts = rbVarOpts << get;\!r\!n\!t\!t\!t\!t\!t\!tevalsummary;\!r\!n\!t\!t\!t\!t\!t)\!r\!n\!t\!t\!t\!t)\!r\!n\!t\!t\!t),\!r\!n\!t\!t\!ttext Box(\!"\!"),\!r\!n\!t\!t\!tobSummary = Outline Box( \!"Test Inputs\!",\!r\!n\!t\!t\!t\!tvlbSummary = V List Box() // display tree stub\!r\!n\!t\!t\!t),\!r\!n\!t\!t\!t//textbox(\!"\!"),\!r\!n\!t\!t\!thlistbox(\!r\!n\!t\!t\!t\!tspacerbox(size(10,1)),\!r\!n\!t\!t\!t\!trdcb = checkbox(\!"Reveal Decision\!", rdob<<close(1-(rdcb<<get)))\!r\!n\!t\!t\!t)\!r\!n\!t\!t),\!r\!n\!t\!tV List Box(\!r\!n\!t\!t\!tobSummaryStats = Outline Box( \!"Summary Statistics\!",\!r\!n\!t\!t\!t\!tTable Box( String Col Box( , summaryLabels ), Number Col Box( , round(x1 || n1 || x2 || n2 || phat1 || phat2 || phatpool || diff, 4) ) )\!r\!n\!t\!t\!t),\!r\!n\!t\!t\!tText Box( \!" \!" ),\!r\!n\!t\!t\!tOutline Box( \!"Test Results\!",\!r\!n\!t\!t\!t\!tresultvlb = vlistbox(\!r\!n\!t\!t\!t\!t\!ttbinference = Table Box(\!r\!n\!t\!t\!t\!t\!t\!tString Col Box( \!"Result\!",\!r\!n\!t\!t\!t\!t\!t\!t\!t{\!"z-score\!", \!"z Critical Values\!", \!"Observed Significance (p-value)\!"}\!r\!n\!t\!t\!t\!t\!t\!t),\!r\!n\!t\!t\!t\!t\!t\!tString Col Box( \!"Value\!", result )\!r\!n\!t\!t\!t\!t\!t)\!r\!n\!t\!t\!t\!t),\!r\!n\!t\!t\!t\!t\!r\!n\!t\!t\!t\!trdob = outlinebox(\!"\!")\!r\!n\!t\!t\!t)\!r\!n\!t\!t)\!r\!n\!t)\!r\!n);\!r\!nrdob << close(1);\!r\!nrdcb << set(0);\!r\!n\!r\!n// get it rolling\!r\!n\!r\!nchangeSummary;\!r\!nevalsummary;\!r\!n\!r\!n\!r\!n\!t\!r\!n);\!r\!n//*********************************************\!r\!nRunSummaryStats = Expr(\!r\!n\!r\!nvarOpts = oldVarOpts = 1;\!r\!nalternative = oldalternative = 1;\!r\!ninferenceTextLabels = {\!"Reject Null Hypothesis\!", \!"Fail to Reject Null Hypothesis\!"};\!r\!ninferenceText = \!" \!";\!r\!nresult = {\!".\!", \!".\!", \!".\!", \!".\!", \!".\!", \!".\!"};\!r\!nparmStr = List(\!r\!n\!t\!t\!"Hypothesized Difference (p2-p1)\!",\!r\!n\!t\!t\!"Sample 1 Count (x1) \!",\!r\!n\!t\!t\!"Sample 1 Size (n1) \!",\!r\!n\!t\!t\!"Sample 2 Count (x2) \!",\!r\!n\!t\!t\!"Sample 2 Size (n2) \!",\!r\!n\!t\!t\!"Significance Level (alpha)\!"\!r\!n);\!r\!nparmVal = Eval List( J( 6, 1, . ) );\!r\!nparmVal[1] = 0; Parmval[6] = 0.05;\!r\!n\!r\!n\!r\!n// macros\!r\!n\!r\!nchangeSummary = Expr(\!r\!n\!tvlbSummary << Delete;\!r\!n\!tlineUpBoxExpr = Expr( Lineup Box( N Col( 2 ) ) );\!r\!n\!tnParms = 6;\!r\!n\!t\!r\!n\!tFor( i = 1, i <= nParms, i++,\!r\!n\!t\!tInsert Into(\!r\!n\!t\!t\!tlineUpBoxExpr,\!r\!n\!t\!t\!tParse( Substitute( \!"Text Box( parmStr[iii] )\!", \!"iii\!", Char( i ) ) )\!r\!n\!t\!t);\!r\!n\!t\!tInsert Into(\!r\!n\!t\!t\!tlineUpBoxExpr,\!r\!n\!t\!t\!tParse(\!r\!n\!t\!t\!t\!tSubstitute(\!r\!n\!t\!t\!t\!t\!t\!t\!"tebiii = Text Edit Box( parmVal[iii],\!r\!n\!t\!t\!t\!t\!t\!t<< Script(\!r\!n\!t\!t\!t\!t\!t\!t\!tuseParm(\!r\!n\!t\!t\!t\!t\!t\!t\!t\!talternative,\!r\!n\!t\!t\!t\!t\!t\!t\!t\!tiii,\!r\!n\!t\!t\!t\!t\!t\!t\!t\!tNum( tebiii << Get Text )\!r\!n\!t\!t\!t\!t\!t\!t\!t)\!r\!n\!t\!t\!t\!t\!t\!t)\!r\!n\!t\!t\!t\!t\!t)\!",\!r\!n\!t\!t\!t\!t\!t\!"iii\!", Char( i )\!r\!n\!t\!t\!t\!t)\!r\!n\!t\!t\!t)\!r\!n\!t\!t);\!r\!n\!t);\!r\!n\!tEval(\!r\!n\!t\!tSubstitute( Expr( obSummary << Append( vlbSummary = V List Box( iii ) ) ),\!r\!n\!t\!t\!tExpr( iii ), Name Expr( lineUpBoxExpr )\!r\!n\!t\!t)\!r\!n\!t);\!r\!n\!toldAlternative = alternative;\!r\!n\!toldVarOpts = varOpts;\!r\!n);\!r\!n\!r\!ninferenceLabels = {\!r\!n\!t\!"Sample 1 Proportion\!",\!r\!n\!t\!"Sample 2 Proportion\!",\!r\!n\!t\!"Difference in Proportions (p2-p1)\!",\!r\!n\!t\!"z-score\!",\!r\!n\!t\!"z Critical Value(s)\!",\!r\!n\!t\!"Observed Significance (p-value) \!"\!r\!n};\!r\!n\!r\!nchangeInference = Expr(\!r\!n\!tevalSummary;\!r\!n);\!r\!n\!r\!nevalSummary = Expr(\!r\!n\!tTry( tbinference << delete );\!r\!n\!tTry( tbdecision << delete );\!r\!n\!t// check specific array for missing values, else proceed\!r\!n\!tIf( Not( Sum( Is Missing( parmVal ) ) ), \!r\!n\!t\!t// perform the test\!r\!n\!t\!tresult = {\!".\!", \!".\!", \!".\!", \!".\!", \!".\!", \!".\!"};\!r\!n\!t\!tdiff = parmval[1];\!r\!n\!t\!tx1 = parmval[2];\!r\!n\!t\!tn1 = parmval[3];\!r\!n\!t\!tx2 = parmval[4];\!r\!n\!t\!tn2 = parmval[5];\!r\!n\!t\!talpha = parmval[6];\!r\!n\!t\!t\!t// perform z test\!r\!n\!t\!t\!tp1 = x1/n1;\!r\!n\!t\!t\!tp2 = x2/n2;\!r\!n\!t\!t\!tresult[1] = char(round(p1, 4));\!r\!n\!t\!t\!tresult[2] = char(round(p2, 4));\!t\!r\!n\!t\!t\!tresult[3] = char(round(p2-p1, 4));\!t\!t\!r\!n\!t\!t\!tppool = (x1+x2)/(n1+n2);\!r\!n\!t\!t\!tsignal = (p2-p1-diff);\!r\!n\!t\!t\!tif (varOpts == 1,\!r\!n\!t\!t\!t\!tp1 = p2 = ppool;\!r\!n\!t\!t\!t);\!r\!n\!t\!t\!tnoise = sqrt(p1*(1-p1)/n1+p2*(1-p2)/n2);\!r\!n\!t\!t\!tresult[4] = Char(\!r\!n\!t\!t\!t\!tRound( signal / noise, 4 )\!r\!n\!t\!t\!t);\!r\!n\!t\!t\!tChoose( alternative,\!r\!n\!t\!t\!t\!tq = Normal Quantile( 1 - (alpha) / 2 );\!r\!n\!t\!t\!t\!tresult[5] = \!"+/- \!" || Char( Round( q, 4 ) );\!r\!n\!t\!t\!t\!tpval = 2 * (1 - Normal Distribution( Abs( Num( result[4] ) ) ));\!r\!n\!r\!n\!t\!t\!t,\!r\!n\!t\!t\!t\!tq = -Normal Quantile( 1 - alpha );\!r\!n\!t\!t\!t\!tresult[5] = Char( Round( q, 4 ) );\!r\!n\!t\!t\!t\!tpval = Normal Distribution( Num( result[4] ) );\!r\!n\!r\!n\!t\!t\!t,\!r\!n\!t\!t\!t\!tq = Normal Quantile( 1 - alpha );\!r\!n\!t\!t\!t\!tresult[5] = Char( Round( q, 4 ) );\!r\!n\!t\!t\!t\!tpval = 1 - Normal Distribution( Num( result[4] ) );\!r\!n\!r\!n\!t\!t\!t);\!r\!n\!t\!t\!tresult[6] = Char( format(pval, \!"pvalue\!", 6 ));\!r\!n\!t\!t\!tIf( pval <= alpha,\!r\!n\!t\!t\!t\!tinferenceText = inferenceTextLabels[1],\!r\!n\!t\!t\!t\!tinferenceText = inferenceTextLabels[2]\!r\!n\!t\!t\!t);\!r\!n\!t\!t\!t\!r\!n\!t);\!r\!n\!tresultvlb << Append(\!r\!n\!t\!t