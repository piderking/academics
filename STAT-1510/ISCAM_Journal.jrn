ButtonBox(title("Hypothesis Test for One Mean"),scriptText("/*\!r\!nTestMean.jsl\!r\!n\!r\!n14 Feb 2013\!r\!n\!r\!nCopyright (c) 2013 by SAS Institute Inc., Cary, NC 27513, USA. All rights reserved.\!r\!n\!r\!nNote: please read the disclaimer at the end of this script.\!r\!n\!r\!nPurpose\!r\!nThis script performs a hypothesis test on the mean using raw data or summary statistics.\!r\!n\!r\!nAuthor\!r\!nBrady Brady (SAS Institute)\!r\!n\!r\!n*/\!r\!n\!r\!nClear Globals();\!r\!nNames Default To Here( 1 );\!r\!n\!r\!n\!r\!nRunRawData = Expr(\!r\!n\!r\!nstatistic = 1;\!r\!nalternative = 1;\!r\!ninferenceTextList = {\!"Reject Null Hypothesis\!", \!"Fail to Reject Null Hypothesis\!"};\!r\!ninferText = \!" \!";\!r\!nresult = {\!".\!", \!".\!", \!".\!"};\!r\!nparmStr = List(\!r\!n\!tList( \!"Hypothesized Mean\!", \!"Population Standard Deviation\!", \!"Significance Level (alpha)\!" ),\!r\!n\!tList( \!"Hypothesized Mean\!", \!"Significance Level (alpha)\!" ),\!r\!n\!r\!n);\!r\!nparmVal = Eval List( List( J( 3, 1, . ), J( 2, 1, . ) ) );\!r\!nsummaryLabels = {\!"Sample Average\!", \!"Sample Standard Deviation\!", \!"Sample Size\!"}; \!r\!n\!r\!n// macros\!r\!n\!r\!nchangeSummary = Expr(\!r\!n\!tvlbSummary << Delete;\!r\!n\!tlineUpBoxExpr = Expr( Lineup Box( N Col( 2 ) ) );\!r\!n\!tnParms = Choose( statistic, 3, 2 );\!r\!n\!tFor( i = 1, i <= nParms, i++,\!r\!n\!t\!tInsert Into(\!r\!n\!t\!t\!tlineUpBoxExpr,\!r\!n\!t\!t\!tParse( Substitute( \!"Text Box( parmStr[statistic][iii] )\!", \!"iii\!", Char( i ) ) )\!r\!n\!t\!t);\!r\!n\!t\!tInsert Into(\!r\!n\!t\!t\!tlineUpBoxExpr,\!r\!n\!t\!t\!tParse(\!r\!n\!t\!t\!t\!tSubstitute(\!r\!n\!t\!t\!t\!t\!t\!t\!"tebiii = Text Edit Box( parmVal[statistic][iii],\!r\!n\!t\!t\!t\!t\!t\!t<< Script(\!r\!n\!t\!t\!t\!t\!t\!t\!tuseParm(\!r\!n\!t\!t\!t\!t\!t\!t\!t\!tstatistic,\!r\!n\!t\!t\!t\!t\!t\!t\!t\!talternative,\!r\!n\!t\!t\!t\!t\!t\!t\!t\!tiii,\!r\!n\!t\!t\!t\!t\!t\!t\!t\!tNum( tebiii << Get Text )\!r\!n\!t\!t\!t\!t\!t\!t\!t)\!r\!n\!t\!t\!t\!t\!t\!t)\!r\!n\!t\!t\!t\!t\!t)\!",\!r\!n\!t\!t\!t\!t\!t\!"iii\!", Char( i )\!r\!n\!t\!t\!t\!t)\!r\!n\!t\!t\!t)\!r\!n\!t\!t);\!r\!n\!t);\!r\!n\!r\!n\!tEval(\!r\!n\!t\!tSubstitute( Expr( obSummary << Append( vlbSummary = V List Box( iii ) ) ),\!r\!n\!t\!t\!tExpr( iii ), Name Expr( lineUpBoxExpr )\!r\!n\!t\!t)\!r\!n\!t);\!r\!n);\!r\!n\!r\!nchangeInference = Expr(\!r\!n\!tinferenceLabels = Insert(\!r\!n\!t\!t{\!"Observed Significance (p-value)\!"},\!r\!n\!t\!tChoose( statistic, \!"z Critical Value(s)\!", \!"t Critical Value(s)\!", ),\!r\!n\!t\!t1\!r\!n\!t);\!r\!n\!tinferenceLabels = Insert( inferenceLabels, Choose( statistic, \!"z-score\!", \!"t-score\!", ), 1 );\!r\!n\!r\!n\!tevalSummary;\!r\!n);\!r\!n\!r\!nevalSummary = Expr(\!r\!n\!t// check specific array for missing values, else proceed\!r\!n\!tTry( tbinference << delete );\!r\!n\!tTry( tbdecision << delete );\!r\!n\!tIf( Not( Sum( Is Missing( parmVal[statistic] ) ) ),\!r\!n\!t\!t// obtain test results\!r\!n\!t\!tmu = parmVal[1][1];\!r\!n\!t\!tsigma = parmval[1][2];\!r\!n\!t\!talpha = parmVal[1][3];\!r\!n\!t\!tresult = {\!".\!", \!".\!", \!".\!"};\!r\!n\!t\!tChoose( statistic, \!r\!n\!t\!t\!t// z test\!r\!n\!t\!t\!tresult[1] = Char( Round( (avg - mu) / sigma * Sqrt( n ), 4 ) );\!r\!n\!t\!t\!tChoose( alternative,\!r\!n\!t\!t\!t\!tq = Normal Quantile( 1 - (alpha) / 2 );\!r\!n\!t\!t\!t\!tresult[2] = \!"+/- \!" || Char( Round( q, 4 ) );\!r\!n\!t\!t\!t\!tpval = 2 * (1 - Normal Distribution( Abs( Num( result[1] ) ) ));\!r\!n\!t\!t\!t,\!r\!n\!t\!t\!t\!tq = -Normal Quantile( 1 - alpha );\!r\!n\!t\!t\!t\!tresult[2] = Char( Round( q, 4 ) );\!r\!n\!t\!t\!t\!tpval = Normal Distribution( Num( result[1] ) );\!r\!n\!t\!t\!t,\!r\!n\!t\!t\!t\!tq = Normal Quantile( 1 - alpha );\!r\!n\!t\!t\!t\!tresult[2] = Char( Round( q, 4 ) );\!r\!n\!t\!t\!t\!tpval = 1 - Normal Distribution( Num( result[1] ) );\!r\!n\!t\!t\!t);\!r\!n\!t\!t, \!r\!n\!t\!t\!t// t test\!r\!n\!t\!t\!tresult[1] = Char( Round( (avg - mu) / std * Sqrt( n ), 4 ) );\!r\!n\!t\!t\