ButtonBox(title("Hypothesis Test for One Proportion"),scriptText("/*\!r\!nTestProportion.jsl\!r\!n\!r\!n14 Feb 2013\!r\!n\!r\!nCopyright (c) 2013 by SAS Institute Inc., Cary, NC 27513, USA. All rights reserved.\!r\!n\!r\!nNote: please read the disclaimer at the end of this script.\!r\!n\!r\!nPurpose\!r\!nThis script performs a hypothesis test on the population proportion using raw data or summary statistics.\!r\!n\!r\!nAuthor\!r\!nBrady Brady (SAS Institute)\!r\!n\!r\!n*/\!r\!n\!r\!nClear Globals();\!r\!nNames Default To Here( 1 );\!r\!n\!r\!ngethistprop = function({x, n, suc},\!r\!n\!t// takes x, n and a string naming success and returns a histogram of sample proportions\!r\!n\!t{dtnew, l, dis, pic},\!r\!n\!tdtnew = newtable(\!"x\!", <<invisible);\!r\!n\!tdtnew << addrows(n);\!r\!n\!tcolumn(dtnew, 1)<<datatype(\!"Character\!");\!r\!n\!tcolumn(dtnew, 1)<<set formula(if(row()>x, \!r\!n\!t\!tif(suc == \!"Success\!", \!"Failure\!", \!"Other\!")\!r\!n\!t\!t,\!r\!n\!t\!tsuc));\!r\!n\!tl = evallist(if(suc==\!"Success\!", {\!"Success\!", \!"Failure\!"}, {suc, \!"Other\!"}));\!r\!n\!tcolumn(dtnew, 1)<<set property(\!"value ordering\!", l);\!r\!n\!tdis = dtnew << Distribution(\!r\!n\!t\!tStack( 1 ),\!r\!n\!t\!tNominal Distribution(\!r\!n\!t\!t\!tColumn( :Column 1 ),\!r\!n\!t\!t\!tHorizontal Layout( 1 ),\!r\!n\!t\!t\!tVertical( 0 ),\!r\!n\!t\!t\!tcount axis(1),\!r\!n\!t\!t\!taxes on left(1),\!r\!n\!t\!t\!tshow percents(1),\!r\!n\!t\!t\!tSeparate Bars( 1 )\!r\!n\!t\!t),\!r\!n\!t\!tinvisible\!r\!n\!t);\!r\!n\!r\!n\!tpic = report(dis)[listbox(4)]<<getpicture;\!r\!n\!tclose(dtnew, nosave);\!r\!n\!tpic;\!r\!n);\!r\!n\!r\!nRunRawData = Expr(\!r\!n\!r\!nstatistic = oldStatistic = 1;\!r\!nalternative = oldalternative = 1;\!r\!ninferencetextlist = {\!"Reject Null Hypothesis\!", \!"Fail to Reject Null Hypothesis\!"};\!r\!nparmStr = List( \!"Hypothesized Proportion\!", \!"Significance Level (alpha)\!" );\!r\!nsummaryLabels = {\!"Number of Successes\!", \!"Sample Size\!", \!"Sample Proportion\!"}; \!r\!ninferText = \!" \!";\!r\!nresult = {\!".\!", \!".\!", \!".\!"};\!r\!nparmVal = Eval List( J( 2, 1, . ) );\!r\!n\!r\!n\!r\!n// macros\!r\!n\!r\!nchangeSummary = Expr(\!r\!n\!tvlbSummary << Delete;\!r\!n\!tlineUpBoxExpr = Expr( Lineup Box( N Col( 2 ) ) );\!r\!n\!tnParms = Choose( statistic, 2, 2 );\!r\!n\!t\!r\!n\!tFor( i = 1, i <= nParms, i++,\!r\!n\!t\!tInsert Into( lineUpBoxExpr, Parse( Substitute( \!"Text Box( parmStr[iii] )\!", \!"iii\!", Char( i ) ) ) );\!r\!n\!t\!tInsert Into(\!r\!n\!t\!t\!tlineUpBoxExpr,\!r\!n\!t\!t\!tParse(\!r\!n\!t\!t\!t\!tSubstitute(\!r\!n\!t\!t\!t\!t\!t\!t\!"tebiii = Text Edit Box( parmVal[iii],\!r\!n\!t\!t\!t\!t\!t\!t<< Script(\!r\!n\!t\!t\!t\!t\!t\!t\!tuseParm(\!r\!n\!t\!t\!t\!t\!t\!t\!t\!tstatistic,\!r\!n\!t\!t\!t\!t\!t\!t\!t\!talternative,\!r\!n\!t\!t\!t\!t\!t\!t\!t\!tiii,\!r\!n\!t\!t\!t\!t\!t\!t\!t\!tNum( tebiii << Get Text )\!r\!n\!t\!t\!t\!t\!t\!t\!t)\!r\!n\!t\!t\!t\!t\!t\!t)\!r\!n\!t\!t\!t\!t\!t)\!",\!r\!n\!t\!t\!t\!t\!t\!"iii\!", Char( i )\!r\!n\!t\!t\!t\!t)\!r\!n\!t\!t\!t)\!r\!n\!t\!t);\!r\!n\!t);\!r\!n\!r\!n\!tEval(\!r\!n\!t\!tSubstitute( Expr( obSummary << Append( vlbSummary = V List Box( iii ) ) ),\!r\!n\!t\!t\!tExpr( iii ), Name Expr( lineUpBoxExpr )\!r\!n\!t\!t)\!r\!n\!t);\!r\!n\!toldStatistic = statistic;\!r\!n\!toldAlternative = alternative;\!r\!n);\!r\!n\!r\!nchangeInference = Expr(\!r\!n\!tinferenceLabels = Insert(\!r\!n\!t\!t{\!"Observed Significance (p-value)\!"},\!r\!n\!t\!tChoose( statistic, \!"z Critical Value(s)\!", \!"x Critical (Upper Limit)\!", ),\!r\!n\!t\!t1\!r\!n\!t);\!r\!n\!tinferenceLabels = Insert( inferenceLabels, Choose( statistic, \!"z-score\!", \!"x Critical (Lower Limit)\!", ), 1 );\!r\!n\!tevalSummary;\!r\!n);\!r\!n\!r\!nevalSummary = Expr(\!r\!n\!t// check specific array for missing values, else proceed\!r\!n\!tIf( Not( Sum( Is Missing( parmVal ) ) ),\!r\!n\!t\!tTry( tbinference << delete );\!r\!n\!t\!tTry( tbdecision << delete );\!r\!n\!t\!t// compute test results\!r\!n\!t\!tresult = {\!".\!", \!".\!", \!".\!"};\!r\!n\!t\!tChoose( statistic, \!r\!n\!t\!t\!t// z test\!r\!n\!t\!t\!tp = parmVal[1];\!r\!n\!t\!t\!talpha = parmVal[2];\!r\!n\!t\!t\!tse = Sqrt( p * (1 - p) / n );\!r\!n\!t\!t\!tteststat = (phat - p) / se;\!r\!n\!t\!t\!tresult[1] = Char( Round( teststat, 4 ) );\!r\!n\!t\!t\!tChoose( alternative,\!r\!n\!t\!t\!t\!tq = Normal Quantile( 1 - (alpha) / 2 );\!r\!n\!t\!t\!t\!tresult[2] = \!"+/- \!" || Char( Round( q, 4 ) );\!r\!n\!t\!t\!t\!tpval = 2 * (1 - Normal Distribution( Abs( Num( result[1] ) ) ));,\!r\!n\!t\!t\!t\!tq = -Normal Quantile( 1 - alpha );\!r\!n\!t\!t\!t\!tresult[2] = Char( Round( q, 4 ) );\!r\!n\!t\!t\!t\!tpval = Normal Distribution( Num( result[1] ) );,\!r\!n\!t\!t\!t\!tq = Normal Quantile( 1 - alpha );\!r\!n\!t\!t\!t\!tresult[2] = Char( Round( q, 4 ) );\!r\!n\!t\!t\!t\!tpval = 1 - Normal Distribution( Num( result[1] ) );\!r\!n\!t\!t\!t);, \!r\!n\!t\!t);\!r\!n\!t\!tresult[3] = Char( Round( pval, 4 ) );\!r\!n\!t\!tIf( pval <= alpha,\!r\!n\!t\!t\!tinferText = inferencetextlist[1],\!r\!n\!t\!t\!tinferText = inferencetextlist[2]\!r\!n\!t\!t);\!r\!n\!t\!tresultvlb << Append(\!r\!n\!t\!t\!ttbInference = Table Box(\!r\!n\!t\!t\!t\!tString Col Box( \!"Result\!", inferenceLabels ),\!r\!n\!t\!t\!t\!tString Col Box( \!"Value\!", result )\!r\!n\!t\!t\!t)\!r\!n\!t\!t);\!r\!n\!t\!trdob << append( tbdecision = Text Box( inferText ) );\!r\!n\!t\!ttbdecision << font color(\!"Red\!");\!t\!t\!t\!t\!t\!t\!r\!n\!t)\!r\!n);\!r\!n\!r\!n// user functions\!r\!ngetFrequency = Function( {inList, sString},\!r\!n\!t{Default Local},\!r\!n\!tn = N Items( inList );\!r\!n\!tfrequency = 0;\!r\!n\!tFor( i = 1, i <= n, i++,\!r\!n\!t\!tIf( inList[i] == sString,\!r\!n\!t\!t\!tfrequency += 1\!r\!n\!t\!t)\!r\!n\!t);\!r\!n\!tfrequency;\!r\!n);\!r\!n\!r\!ncalcNecessaryStatistics = Function( {dt},\!r\!n\!t{Default Local},\!r\!n\!tIf( Is Empty( dt ),\!r\!n\!t\!tTry( dt = Open() );\!r\!n\!t\!tIf( Is Empty( dt ),\!r\!n\!t\!t\!tNew Window( ,\!r\!n\!t\!t\!t\!tmodal,\!r\!n\!t\!t\!t\!tText Box( \!r\!n\!t\!t\!t\!t\!t\!"No Data Table Selected. Script Terminating.\!" \!r\!n\!t\!t\!t\!t)\!r\!n\!t\!t\!t);\!r\!n\!t\!t\!tstop();\!r\!n\!t\!t);\!r\!n\!t);\!r\!n\!tnc = N Col( dt );\!r\!n\!tIf( nc == 1,\!r\!n\!t\!tm = Column( 1 ) << get values;\!r\!n\!t\!tres = Dialog( \!"\!", HList( \!"Value Associated with a Success\!", ex = EditText( \!"Success\!" ) ) );\!r\!n\!t\!tIf( res[\!"button\!"] == 1,\!r\!n\!t\!t\!tsuccessString = res[\!"ex\!"],\!r\!n\!t\!t\!tm = J( 0, 0, 0 )\!r\!n\!t\!t);\!r\!n\!t,\!r\!n\!t\!tres = Column Dialog(\!r\!n\!t\!t\!tc = ColList( \!"Pick a Column\!", Max Col( 1 ) ),\!r\!n\!t\!t\!tHList( \!"Value Associated with a Success\!", ex = EditText( \!"Success\!" ) )\!r\!n\!t\!t);\!r\!n\!t\!tIf( res[\!"button\!"] == 1,\!r\!n\!t\!t\!tm = res[\!"c\!"][1] << get values;\!r\!n\!t\!t\!tsuccessString = res[\!"ex\!"];\!r\!n\!t\!t,\!r\!n\!t\!t\!tNew Window( , modal,\!r\!n\!t\!t\!t\!tText Box(\!"No Column Selected. Script Terminating.\!")\!r\!n\!t\!t\!t);\!r\!n\!t\!t\!tstop();\!r\!n\!t\!t);\!r\!n\!t);\!r\!n\!tShow( res );\!r\!n\!tIf( Is List( m ), \!r\!n\!t//Nominal Variable\!r\!n\!t\!tx = getFrequency( m, successString );\!r\!n\!t\!tn = N Items( m );\!r\!n\!t\!tnmiss = N Missing( m );\!r\!n\!t\!tn -= nmiss;\!r\!n\!t, \!r\!n\!t//Continuous Variable\!r\!n\!t\!tn = N Row( m );\!r\!n\!t\!tinList = {};\!r\!n\!t\!tFor( i = 1, i <= n, i++,\!r\!n\!t\!t\!tinList[i] = Char( m[i] )\!r\!n\!t\!t);\!r\!n\!t\!tx = getFrequency( inList, successString );\!r\!n\!t\!tnmiss = N Missing( m );\!r\!n\!t\!tn -= nmiss;\!r\!n\!t);\!r\!n\!tphat = Round( x / n, 4 );\!r\!n\!tEval List( {x, n, phat, successString} );\!r\!n);\!r\!n\!r\!nuseParm = Function( {s, a, p, v},\!r\!n\!tIf( checkParm( s, a, p, v ),\!r\!n\!t\!tparmVal[p] = v;\!r\!n\!t\!tevalSummary;\!r\!n\!t,\!r\!n\!t\!tvlbSummary[Text Edit Box( p )] << Set Text( Char( parmVal[p] ) )\!r\!n\!t)\!r\!n);\!r\!n\!r\!ncheckParm = Function( {s, a, p, v},\!r\!n\!tIf( Not( Is Missing( v ) ),\!r\!n\!t\!tChoose( p, \!r\!n\!t\!t\!t// Hyp Proportion\!r\!n\!t\!t\!t0 < v < 1, \!r\!n\!t\!t\!t// Significance Level\!r\!n\!t\!t\!t0 < v < 1\!r\!n\!t\!t) \!r\!n\!t,\!r\!n\!t\!t0\!r\!n\!t)\!r\!n);\!r\!n\!r\!n// present application\!r\!n\!r\!ndt = Current Data Table();\!r\!n{x, n, phat, sucstr} = calcNecessaryStatistics( dt );\!r\!n\!r\!nNew Window( \!"Hypothesis Test on Proportion\!",\!r\!n\!tH List Box(\!r\!n\!t\!tOutline Box( \!"Choose Type of Alternative Hypothesis\!",\!r\!n\!t\!t\!tV List Box(\!r\!n\!t\!t\!t\!trbalternative = Radio Box(\!r\!n\!t\!t\!t\!t\!t{\!"Population mean is not equal to hypothesized mean (two-tailed)\!",\!r\!n\!t\!t\!t\!t\!t\!"Population mean is less than hypothesized mean (one-tailed)\!",\!r\!n\!t\!t\!t\!t\!t\!"Population mean is greater than hypothesized mean (one-tailed)\!"},\!r\!n\!t\!t\!t\!t\!t<<Script(\!r\!n\!t\!t\!t\!t\!t\!talternative = rbalternative << get;\!r\!n\!t\!t\!t\!t\!t\!tIf( oldalternative != alternative,\!r\!n\!t\!t\!t\!t\!t\!t\!tchangeSummary;\!r\!n\!t\!t\!t\!t\!t\!t\!tchangeInference;\!r\!n\!t\!t\!t\!t\!t\!t);\!r\!n\!t\!t\!t\!t\!t)\!r\!n\!t\!t\!t\!t),\!r\!n\!t\!t\!t\!tText Box( \!" \!" ),\!r\!n\!t\!t\!t\!tobSummary = Outline Box( \!"Test Inputs\!",\!r\!n\!t\!t\!t\!t\!tvlbSummary = V List Box() // display tree stub\!r\!n\!t\!t\!t\!t),\!r\!n\!t\!t\!t\!ttextbox(\!"\!"),\!r\!n\!t\!t\!t\!thlistbox(\!r\!n\!t\!t\!t\!t\!tspacerbox(size(10,1)),\!r\!n\!t\!t\!t\!t\!trdcb = checkbox(\!"Reveal Decision\!", rdob<<close(1-(rdcb<<get)))\!r\!n\!t\!t\!t\!t)\!r\!n\!t\!t\!t)\!r\!n\!t\!t),\!r\!n\!t\!tV List Box(\!r\!n\!t\!t\!tobSummaryStats = Outline Box( \!"Summary Statistics\!",\!r\!n\!t\!t\!t\!tVlistbox(\!r\!n\!t\!t\!t\!t\!thlistbox(\!r\!n\!t\!t\!t\!t\!t\!thcenterbox(\!r\!n\!t\!t\!t\!t\!t\!t\!tgethistprop(x, n, sucstr)\!r\!n\!t\!t\!t\!t\!t\!t)\!r\!n\!t\!t\!t\!t\!t),\!r\!n\!t\!t\!t\!t\!thcenterbox(\!r\!n\!t\!t\!t\!t\!t\!tTable Box( String Col Box( , summaryLabels ), Number Col Box( , x || n || phat ) )\!r\!n\!t\!t\!t\!t\!t)\!r\!n\!t\!t\!t\!t)\!r\!n\!t\!t\!t),\!r\!n\!t\!t\!tText Box( \!" \!" ),\!r\!n\!t\!t\!thcenterbox(\!r\!n\!t\!t\!t\!tOutline Box( \!"Test Results\!",\!r\!n\!t\!t\!t\!t\!tresultvlb = vlistbox(\!r\!n\!t\!t\!t\!t\!t\!ttbinference = Table Box(\!r\!n\!t\!t\!t\!t\!t\!t\!tString Col Box( \!"Result\!",\!r\!n\!t\!t\!t\!t\!t\!t\!t\!t{\!"z-score\!", \!"z Critical Values\!", \!"Observed Significance (p-value)\!"}\!r\!n\!t\!t\!t\!t\!t\!t\!t),\!r\!n\!t\!t\!t\!t\!t\!t\!tString Col Box( \!"Value\!", result )\!r\!n\!t\!t\!t\!t\!t\!t)\!r\!n\!t\!t\!t\!t\!t),\!r\!n\!t\!t\!t\!t\!trdob = outlinebox(\!"\!")\!r\!n\!t\!t\!t\!t)\!r\!n\!t\!t\!t)\!r\!n\!t\!t)\!r\!n\!t)\!r\!n);\!r\!nrdcb << set(0);\!r\!nrdob << close(1);\!r\!n// get it rolling\!r\!n\!r\!nchangeSummary;\!r\!nchangeInference;\!r\!n\!r\!n\!t\!r\!n);\!r\!n//*********************************************\!r\!nRunSummaryStats = Expr(\!r\!n\!r\!nstatistic = 1; //save for exact Binomial enhancement\!r\!nalternative = 1;\!r\!ninferenceTextList = {\!"Reject Null Hypothesis\!", \!"Fail to Reject Null Hypothesis\!"};\!r\!ninferenceText = \!"\!";\!r\!nresult = {\!".\!", \!".\!", \!".\!", \!".\!"};\!r\!nparmStr = List(\!r\!n\!tList(\!r\!n\!t\!t\!"Hypothesized Proportion\!",\!r\!n\!t\!t\!"Number of Successes\!",\!r\!n\!t\!t\!"Sample Size\!",\!r\!n\!t\!t\!"Significance Level (alpha)\!"\!r\!n\!t)\!r\!n);\!r\!nparmVal = Eval List( J( 4, 1, . ) );\!r\!n\!r\!n// macros\!r\!n\!r\!nchangeSummary = Expr(\!r\!n\!tvlbSummary << Delete;\!r\!n\!tlineUpBoxExpr = Expr( Lineup Box( N Col( 2 ) ) );\!r\!n\!tnParms = Choose( statistic, 4, 4 );\!r\!n\!tFor( i = 1, i <= nParms, i++,\!r\!n\!t\!tInsert Into(\!r\!n\!t\!t\!tlineUpBoxExpr,\!r\!n\!t\!t\!tParse(\!r\!n\!t\!t\!t\!tSubstitute( \!"Text Box( parmStr[statistic][iii] )\!",\!r\!n\!t\!t\!t\!t\!t\!"iii\!", Char( i )\!r\!n\!t\!t\!t\!t)\!r\!n\!t\!t\!t)\!r\!n\!t\!t);\!r\!n\!t\!tInsert Into(\!r\!n\!t\!t\!tlineUpBoxExpr,\!r\!n\!t\!t\!tParse(\!r\!n\!t\!t\!t\!tSubstitute(\!r\!n\!t\!t\!t\!t\!t\!t\!"tebiii = Text Edit Box( parmVal[iii],\!r\!n\!t\!t\!t\!t\!t\!t<< Script(\!r\!n\!t\!t\!t\!t\!t\!t\!tuseParm(\!r\!n\!t\!t\!t\!t\!t\!t\!t\!tstatistic,\!r\!n\!t\!t\!t\!t\!t\!t\!t\!talternative,\!r\!n\!t\!t\!t\!t\!t\!t\!t\!tiii,\!r\!n\!t\!t\!t\!t\!t\!t\!t\!tNum( tebiii << Get Text )\!r\!n\!t\!t\!t\!t\!t\!t\!t)\!r\!n\!t\!t\!t\!t\!t\!t)\!r\!n\!t\!t\!t\!t\!t)\!",\!r\!n\!t\!t\!t\!t\!t\!"iii\!", Char( i )\!r\!n\!t\!t\!t\!t)\!r\!n\!t\!t\!t)\!r\!n\!t\!t);\!r\!n\!t);\!r\!n\!tEval(\!r\!n\!t\!tSubstitute(\!r\!n\!t\!t\!t\!tExpr( obSummarycb << Append( vlbSummary = V List Box( iii ) ) ),\!r\!n\!t\!t\!tExpr( iii ), Name Expr( lineUpBoxExpr )\!r\!n\!t\!t)\!r\!n\!t);\!r\!n);\!r\!n\!r\!nchangeInference = Expr(\!r\!n\!tinferenceLabels = {\!"Estimated Proportion\!", \!"z Critical Values\!",\!r\!n\!t\!"Test Statistic\!", \!"Observed Significance (p-Value)\!"};\!r\!n\!tevalSummary;\!r\!n);\!r\!n\!r\!nevalSummary = Expr(\!r\!n\!t// check specific array for missing values, else proceed\!r\!n\!tTry( tbinference << delete );\!r\!n\!tTry( tbdecision << delete );\!r\!n\!tIf( Not( Sum( Is Missing( parmVal ) ) ),\!r\!n\!t\!t// compute test results\!r\!n\!t\!tresult = {\!".\!", \!".\!", \!".\!"};\!r\!n\!t\!tphyp = parmVal[1];\!r\!n\!t\!tphat = parmVal[2] / parmVal[3];\!r\!n\!t\!tn = parmVal[3];\!r\!n\!t\!talpha = parmVal[4];\!r\!n\!t\!tresult[1] = Char( Round( phat, 4 ) );\!r\!n\!t\!tresult[3] = Char( Round( (Num( phat - phyp ) / Sqrt( Num( phyp ) * (1 - Num( phyp )) / n )), 4 ));\!r\!n\!t\!tChoose( alternative,\!r\!n\!t\!t\!tq = Normal Quantile( 1 - (alpha) / 2 );\!r\!n\!t\!t\!tresult[2] = \!"+/- \!" || Char( Round( q, 4 ) );\!r\!n\!t\!t\!tpval = 2 * (1 - Normal Distribution( Abs( Num( result[3] ) ) ));\!r\!n\!t\!t\!t,\!r\!n\!t\!t\!tq = -Normal Quantile( 1 - alpha );\!r\!n\!t\!t\!tresult[2] = Char( Round( q, 4 ) );\!r\!n\!t\!t\!tpval = Normal Distribution( Num( result[3] ) );\!r\!n\!t\!t\!t,\!r\!n\!t\!t\!tq = Normal Quantile( 1 - alpha );\!r\!n\!t\!t\!tresult[2] = Char( Round( q, 4 ) );\!r\!n\!t\!t\!tpval = 1 - Normal Distribution( Num( result[3] ) );\!r\!n\!t\!t);\!r\!n\!t\!tresult[4] = Char( Round( pval, 4 ) );\!r\!n\!t\!tIf( pval <= parmVal[4],\!r\!n\!t\!t\!tinferenceText = inferenceTextList[1]\!r\!n\!t\!t,\!r\!n\!t\!t\!tinferenceText = inferenceTextList[2]\!r\!n\!t\!t);\!r\!n\!t\!ttry(histpic<<delete); histhcb<<append(histpic = hlistbox(gethistprop(parmval[2], n, \!"Success\!")));\!t\!r\!n\!t);\!r\!n\!tresultvlb << Append(\!r\!n\!t\!ttbInference = Table Box(\!r\!n\!t\!t\!tString Col Box( \!"Result\!", inferenceLabels ),\!r\!n\!t\!t\!tString Col Box( \!"Value\!", result )\!r\!n\!t\!t)\!r\!n\!t);\!r\!n\!trdob << append( tbdecision = Text Box( inferenceText ) );\!r\!n\!ttbdecision << font color( \!"Red\!" );\!r\!n\!t\!r\!n);\!r\!n\!r\!n// user functions\!r\!n\!r\!nuseParm = Function( {s, a, p, v},\!r\!n\!tIf( checkParm( s, a, p, v ),\!r\!n\!t\!tparmVal[p] = v;\!r\!n\!t\!tevalSummary;\!r\!n\!t,\!r\!n\!t\!tvlbSummary[Text Edit Box( p )] << Set Text( Char( parmVal[p] ) )\!r\!n\!t)\!r\!n);\!r\!n\!r\!ncheckParm = Function( {s, a, p, v},\!r\!n\!tIf( Not( Is Missing( v ) ),\!r\!n\!t\!tChoose( p, \!r\!n\!t\!t\!t// Hyp Proportion\!r\!n\!t\!t\!t0 < v < 1, \!r\!n\!t\!t\!t// Number of successes\!r\!n\!t\!t\!tv == Floor( v ) & v >= 0 & Or((v <= Num( teb3 << get text )), Is Missing( Num( teb3 << gettext ) ) )\!r\!n\!t\!t\!t, \!r\!n\!t\!t\!t// Sample Size\!r\!n\!t\!t\!tv == Floor( v ) & v > 0 & Or( (v >= Num( teb2 << get text )), Is Missing( Num( teb2 << gettext ) ) )\!r\!n\!t\!t\!t, \!r\!n\!t\!t\!t// Significance Level\!r\!n\!t\!t\!t0 < v < 1\!r\!n\!t\!t)\!r\!n\!t,\!r\!n\!t\!t0\!r\!n\!t)\!r\!n);\!r\!n\!r\!n// present application\!r\!n\!r\!nNew Window( \!"Hypothesis Test on Proportion\!",\!r\!n\!tH List Box(\!r\!n\!t\!tOutline Box( \!"Choose Type of Alternative Hypothesis\!",\!r\!n\!t\!t\!tV List Box(\!r\!n\!t\!t\!t\!trbalternative = Radio Box(\!r\!n\!t\!t\!t\!t\!t{\!r\!n\!t\!t\!t\!t\!t\!"Population proportion is not equal to hypothesized proportion (two-tailed)\!",\!r\!n\!t\!t\!t\!t\!t\!"Population proportion is less than hypothesized proporti