ButtonBox(title("Hypothesis Test for Two Means"),scriptText("/*\!r\!nTestTwoSampleMeans.jsl\!r\!n\!r\!n14 Feb 2013\!r\!n\!r\!nCopyright (c) 2013 by SAS Institute Inc., Cary, NC 27513, USA. All rights reserved.\!r\!n\!r\!nNote: please read the disclaimer at the end of this script.\!r\!n\!r\!nPurpose\!r\!nThis script performs a hypothesis test on two sample means using raw data or summary statistics.\!r\!n\!r\!nAuthor\!r\!nBrady Brady (SAS Institute)\!r\!n\!r\!n*/\!r\!n\!r\!nClear Globals();\!r\!nNames Default To Here( 1 );\!r\!n\!r\!n\!r\!nRunRawData = Expr(\!r\!n\!r\!nstatistic = 1;\!r\!noldVarOpts = varOpts = 1;\!r\!nalternative = 1;\!r\!ninferenceTextList = {\!"Reject Null Hypothesis\!", \!"Fail to Reject Null Hypothesis\!"};\!r\!ninferText = \!" \!";\!r\!nresult = {\!".\!", \!".\!", \!".\!"};\!r\!nparmStr = List(\!r\!n\!tList( \!"Hypothesized Difference in Means (u2-u1)\!", \!"Population 1 Standard Deviation\!", \!"Population 2 Standard Deviation\!", \!"Significance Level (alpha)\!" ),\!r\!n\!tList( \!"Hypothesized Difference in Means (u2-u1)\!", \!"Significance Level (alpha)\!" ),\!r\!n\!r\!n);\!r\!nparmVal = Eval List( List( J( 4, 1, . ), J( 2, 1, . ) ) );\!r\!nparmVal[1][1] = parmVal[2][1] = 0; parmVal[1][4] = parmVal[2][2] = 0.05;\!r\!nsummaryLabels = {\!"Sample 1 Mean\!", \!"Sample 1 Standard Deviation\!", \!"Sample 1 Size\!", \!"Sample 2 Mean\!", \!"Sample 2 Standard Deviation\!", \!"Sample 2 Size\!", \!"Pooled Estimate of Standard Deviation\!", \!"Difference in Sample Means (Mean 2 - Mean 1) \!"}; \!r\!n\!r\!n// macros\!r\!n\!r\!nchangeSummary = Expr(\!r\!n\!tvlbSummary << Delete;\!r\!n\!tlineUpBoxExpr = Expr( Lineup Box( N Col( 2 ) ) );\!r\!n\!tnParms = Choose( statistic, 4, 2 );\!r\!n\!tFor( i = 1, i <= nParms, i++,\!r\!n\!t\!tInsert Into(\!r\!n\!t\!t\!tlineUpBoxExpr,\!r\!n\!t\!t\!tParse( Substitute( \!"Text Box( parmStr[statistic][iii] )\!", \!"iii\!", Char( i ) ) )\!r\!n\!t\!t);\!r\!n\!t\!tInsert Into(\!r\!n\!t\!t\!tlineUpBoxExpr,\!r\!n\!t\!t\!tParse(\