ButtonBox(title("Confidence Interval for Two Proportions"),scriptText("/*\!r\!nDate: 12 Sept 2016\!r\!n\!r\!nCopyright (c) 2016 by SAS Institute Inc., Cary, NC 27513, USA. All rights reserved.\!r\!n\!r\!nNote: please read the disclaimer at the end of this script.\!r\!n\!r\!nPurpose: This script constructs a confidence interval for the difference in two proportions.\!r\!n\!r\!n\!r\!nAuthor:\!r\!nBrady Brady and Julian Parris (SAS Institute)\!r\!n\!r\!n*/\!r\!n\!r\!n\!r\!n\!r\!n\!r\!n\!r\!n\!r\!nnamesdefaulttohere(1);\!r\!nclear globals();\!r\!n\!r\!n\!r\!nfromSum = expr(\!r\!n\!r\!n\!tinitVars = expr(\!r\!n\!t\!tconf = 0.95;\!r\!n\!t\!tn1 = n2 = x1 = x2 = .;\!r\!n\!t\!tInputStatText = {\!"Sample 1 Count\!", \!"Sample 1 Size\!", \!"Sample 2 Count\!", \!"Sample 2 Size\!"};\!r\!n\!t\!tstats = J(nitems(InputStatText), 1, .);\!r\!n\!t\!tresulttext = {\!"Sample Proportion 1\!", \!"Standard Error 1\!", \!"Sample Proportion 2\!", \!"Standard Error 2\!", \!"Difference in Proportions (p2 - p1)\!", \!"Standard Error (p2 - p1)\!", \!"Z quantile\!", \!"Lower Limit\!", \!"Upper Limit\!"};\!r\!n\!t\!tInputErrMsg = \!"Input Error:\!\!N\!\!NAll inputs must be non-negative integers, with Count 1 <= Size 1, Count 2 <= Size 2 and both Sizes > 0.\!r\!n\!t\!t\!t\!t\!t\!t\!\!NConfidence must be between 0 and 1, exclusve.\!\!N\!\!NResetting values.\!";\!r\!n\!t\!tresult = j(9,1,.);\!r\!n\!t);\!r\!n\!tinitvars;\!r\!n\!r\!n\!r\!n\!tcheckinput = function({stats},\!r\!n\!t\!t{r, valid},\!r\!n\!t\!tr = issnceb<<getasmatrix;\!r\!n\!t\!tvalid = all(\!r\!n\!t\!t\!t( r >= [0,1,0,1] )\!r\!n\!t\!t\!t& ( r[2] >= r[1] )\!r\!n\!t\!t\!t& ( r[4] >= r[3] )\!r\!n\!t\!t\!t& ( r == floor(r))\!r\!n\!t\!t\!t& ( 0 < num(cneb<<get text) < 1)\!r\!n\!t\!t);\!r\!n\!t\!tif(ismissing(valid), valid=0);\!r\!n\!t\!tif(valid, \!r\!n\!t\!t\!tconf = num(cneb<<get text);\!r\!n\!t\!t\!tstats = r\!r\!n\!t\!t,\!r\!n\!t\!t\!tmsg(\!"Error!\!", InputErrMsg);\!r\!n\!t\!t\!tcneb<<set(conf);\!r\!n\!t\!t\!tissnceb << set (aslist(stats))\!r\!n\!t\!t);\!r\!n\!t\!tevallist({valid, stats});\!r\!n\!t);\!r\!n\!r\!n\!tcomputeResults = function({stats, result}, {alpha, x1, x2, n1, n2, p1, p2, se1, se2, diff, sediff, z},\!r\!n\!t\!t{valid, stats} = checkinput(stats);\!r\!n\!t\!t{x1, n1, x2, n2} = aslist(stats);\!r\!n\!t\!t\!r\!n\!t\!tif(valid,\!r\!n\!t\!t\!talpha = 1-conf;\!r\!n\!t\!t\!tresult[1] = p1 = x1/n1;\!r\!n\!t\!t\!tresult[2] = se1 = sqrt(p1*(1-p1)/n1);\!t\!r\!n\!t\!t\!tresult[3] = p2 = x2/n2;\!r\!n\!t\!t\!tresult[4] = se2 = sqrt(p2*(1-p2)/n2);\!t\!r\!n\!t\!t\!tresult[5] = diff = p2-p1;\!r\!n\!t\!t\!tresult[6] = sediff = sqrt(se1^2 + se2^2);\!r\!n\!t\!t\!tresult[7] = z = normalquantile(1-alpha/2);\!r\!n\!t\!t\!tresult[8] = max(-1, diff - z*sediff);\!r\!n\!t\!t\!tresult[9] = min(1, diff + z*sediff);\!r\!n\!t\!t);\!r\!n\!t\!tevallist({stats, round(result, 4)})\!r\!n\!t);\!r\!n\!r\!n\!tupdateResults = function({stats, result},\!r\!n\!t\!t{stats,result} = computeResults(stats, result);\!r\!n\!t\!tIf(all(!ismissing((result))),\!r\!n\!t\!t\!ttry(civlb<<delete);\!t\!t\!t\!t\!r\!n\!t\!t\!tciolb << append(\!r\!n\!t\!t\!t\!tcivlb = vlistbox(\!r\!n\!t\!t\!t\!t\!ttablebox(\!r\!n\!t\!t\!t\!t\!t\!tstringcolbox(\!"Result\!", resulttext),\!r\!n\!t\!t\!t\!t\!t\!tresncb = numbercolbox(\!"Value\!", result)\!r\!n\!t\!t\!t\!t\!t),\!r\!n\!t\!t\!t\!t\!thcenterbox(\!r\!n\!t\!t\!t\!t\!t\!tgb = Graph Box(\!r\!n\!t\!t\!t\!t\!t\!t\!t\!tFrame Size( 250, 50 ),\!r\!n\!t\!t\!t\!t\!t\!t\!t\!tX Name( \!"p2 - p1\!" ),\!r\!n\!t\!t\!t\!t\!t\!t\!t\!txscale (-1, 1),\!r\!n\!t\!t\!t\!t\!t\!t\!t\!tPen Color( \!"red\!" );\!r\!n\!t\!t\!t\!t\!t\!t\!t\!tH Line( result[8], result[9], 40 ); // interval\!r\!n\!t\!t\!t\!t\!t\!t\!t\!tV Line( result[8], 30, 50 ); // right end\!r\!n\!t\!t\!t\!t\!t\!t\!t\!tV Line( result[9], 30, 50 ); // left end\!r\!n\!t\!t\!t\!t\!t\!t\!t\!tPen Color(\!"blue\!");\!r\!n\!t\!t\!t\!t\!t\!t\!t\!tV Line((result[8]+result[9])/2, 30, 50)\!r\!n\!t\!t\!t\!t\!t\!t)\!r\!n\!t\!t\!t\!t\!t)\!r\!n\!t\!t\!t\!t)\!r\!n\!t\!t\!t);\!r\