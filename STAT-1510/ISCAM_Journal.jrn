ButtonBox(title("Confidence Interval for One Mean"),scriptText("/*\!r\!nConfidenceIntervalsForTheMean.jsl\!r\!n\!r\!n14 February 2013\!r\!n\!r\!nCopyright (c) 2013 by SAS Institute Inc., Cary, NC 27513, USA. All rights reserved.\!r\!n\!r\!nNote: please read the disclaimer at the end of this script.\!r\!n\!r\!nPurpose\!r\!nThis script computes confidence intervals for the mean using raw or summary data.\!r\!n\!r\!nAuthor\!r\!nBrady Brady (JMP Division, SAS Institute)\!r\!n\!r\!n*/\!r\!n\!r\!nClear Globals();\!r\!nNames Default to Here(1);\!r\!n\!r\!nrunCIforMeanFromData = Expr(\!r\!noldCenter = center = 0;\!r\!noldStatistic = statistic = 1;\!r\!nresult = J( 4, 1, . );\!r\!nparmStr = List(\!r\!n\!tList( \!"Sigma (known)\!" ),\!r\!n\!tList(  ),\!r\!n);\!r\!nparmVal = Eval List(\!r\!n\!tList(\!r\!n\!t\!tJ( 1, 1, . ),\!r\!n\!t\!tJ( 0, 1, . )\!r\!n\!t)\!r\!n);\!r\!nalpha = 0.95;\!r\!ndt = Current Data Table();\!r\!nflagfirstz = 1;\!r\!n\!r\!n// macros\!r\!n\!r\!nchangeSummary = Expr(\!r\!n\!ttry(obSummary << Delete);\!r\!n\!tlineUpBoxExpr = Expr( Line Up Box( N Col(2) ) );\!r\!n\!tnParms = Choose( statistic, 1, 0 );\!r\!n\!t\!r\!n\!tFor( i = 1, i <= nParms, i++,\!r\!n\!t\!tInsert Into( lineUpBoxExpr,\!r\!n\!t\!t\!tParse(\!r\!n\!t\!t\!t\!tSubstitute(\!r\!n\!t\!t\!t\!t\!t\!"Text Box( parmStr[statistic][iii] )\!",\!r\!n\!t\!t\!t\!t\!t\!"iii\!",\!r\!n\!t\!t\!t\!t\!tChar( i )\!r\!n\!t\!t\!t\!t)\!r\!n\!t\!t\!t)\!r\!n\!t\!t);\!r\!n\!t\!tInsert Into( lineUpBoxExpr,\!r\!n\!t\!t\!tParse(\!r\!n\!t\!t\!t\!tSubstitute(\!r\!n\!t\!t\!t\!t\!t\!"tebiii = Text Edit Box( parmVal[statistic][iii],\!r\!n\!t\!t\!t\!t\!t\!t<< Script(\!r\!n\!t\!t\!t\!t\!t\!t\!tuseParm(\!r\!n\!t\!t\!t\!t\!t\!t\!t\!tstatistic,\!r\!n\!t\!t\!t\!t\!t\!t\!t\!tiii,\!r\!n\!t\!t\!t\!t\!t\!t\!t\!tNum( tebiii << Get Text )\!r\!n\!t\!t\!t\!t\!t\!t\!t)\!r\!n\!t\!t\!t\!t\!t\!t)\!r\!n\!t\!t\!t\!t\!t)\!",\!r\!n\!t\!t\!t\!t\!t\!"iii\!",\!r\!n\!t\!t\!t\!t\!tChar( i )\!r\!n\!t\!t\!t\!t)\!r\!n\!t\!t\!t)\!r\!n\!t\!t);\!r\!n\!t);\!r\!n\!r\!n\!tIf(nparms,\!r\!n\!t\!tEval(\!r\!n\!t\!t\!tSubstitute(\!r\!n\!t\!t\!t\!tExpr(\!r\!n\!t\!t\!t\!t\!tvlbSummaryParent << Append(\!r\!n\!t\!t\!t\!t\!t\!tobSummary = Outline Box(\!"Input\!",\!r\!n\!t\!t\!t\!t\!t\!t\!tvlbSummary = V List Box( iii )\!r\!n\!t\!t\!t\!t\!t\!t)\!r\!n\!t\!t\!t\!t\!t)\!r\!n\!t\!t\!t\!t),\!r\!n\!t\!t\!t\!tExpr( iii ),\!r\!n\!t\!t\!t\!tName Expr( lineUpBoxExpr )\!r\!n\!t\!t\!t)\!r\!n\!t\!t);\!r\!n\!t);\!r\!n);\!r\!n\!r\!nchangeInference = Expr(\!r\!n\!tvlbInference << Delete;\!r\!n\!tinferenceLabels = Insert(\!r\!n\!t\!t{ \!"Lower Limit\!", \!"Upper Limit\!" },\!r\!n\!t\!tChoose( statistic,\!r\!n\!t\!t\!t\!"Standard Deviation of the Mean\!",\!r\!n\!t\!t\!t\!"Standard Error of the Mean       \!",\!r\!n\!t\!t),\!r\!n\!t\!t1\!r\!n\!t);\!r\!n\!tinferenceLabels = Insert(\!r\!n\!t\!tinferenceLabels,\!r\!n\!t\!tChoose( statistic,\!r\!n\!t\!t\!t\!"z multiplier\!",\!r\!n\!t\!t\!t\!"t multiplier\!",\!r\!n\!t\!t),\!r\!n\!t\!t1\!r\!n\!t);\!r\!n\!tobInference << Append(\!r\!n\!t\!tvlbInference = V List Box(\!r\!n\!t\!t\!tTable Box(\!r\!n\!t\!t\!t\!tString Col Box( \!"Result\!",\!r\!n\!t\!t\!t\!t\!tinferenceLabels\!r\!n\!t\!t\!t\!t),\!r\!n\!t\!t\!t\!tNumber Col Box( \!"Value\!",\!r\!n\!t\!t\!t\!t\!tJ( 4, 1, . )\!r\!n\!t\!t\!t\!t)\!r\!n\!t\!t\!t),\!r\!n\!t\!t\!thcenterbox(\!r\!n\!t\!t\!t\!tgb = Graph Box(\!r\!n\!t\!t\!t\!t\!t\!tFrame Size( 250, 50 ),\!r\!n\!t\!t\!t\!t\!t\!tX Name( \!"Mean\!" ),\!r\!n\!t\!t\!t\!t\!t\!tX Scale( -1, 1 ),\!r\!n\!t\!t\!t\!t\!t\!tPen Color( \!"red\!" );\!r\!n\!t\!t\!t\!t\!t\!tH Line( result[3], result[4], 40 ); // interval\!r\!n\!t\!t\!t\!t\!t\!tV Line( result[3], 30, 50 ); // right end\!r\!n\!t\!t\!t\!t\!t\!tV Line( result[4], 30, 50 ); // left end\!r\!n\!t\!t\!t\!t\!t\!tPen Color(\!"blue\!");\!r\!n\!t\!t\!t\!t\!t\!tV line((result[3]+result[4])/2, 30,50);\!r\!n\!t\!t\!t\!t)\!r\!n\!t\!t\!t)\!r\!n\!t\!t)\!r\!n\!t);\!r\!n\!tFixPlot;\!r\!n\!tevalSummary;\!r\!n);\!r\!n\!r\!nevalSummary = Expr(\!r\!n\!t// check specific array for missing values, else proceed\!r\!n\!tIf( Or(Not( Sum( Is Missing( parmVal[statistic] ) ) ), statistic == 2) ,\!r\!n\!t\!t// confidence interval\!r\!n\!t\!tresult = J( 4, 1, . );\!r\!n\!t\!tChoose( statistic,\!r\!n\!t\!t\!t// z interval\!r\!n\!t\!t\!tsigma = parmVal[1][1];\!r\!n\!t\!t\!tresult[2] = sigma/Sqrt(n);\!r\!n\!t\!t\!tq = Normal Quantile(1 - (1-alpha)/2 ),\!r\!n\!t\!t\!t// t interval\!r\!n\!t\!t\!tresult[2] = std/Sqrt(n);\!r\!n\!t\!t\!tq = t Quantile( 1 - (1-alpha)/2 , n-1 );\!r\!n\!t\!t);\!r\!n\!t\!tresult[1] = q;\!r\!n\!t\!t{ result[3], result[4] } = avg + { -1, 1 } * q * result[2];\!r\!n\!t\!tcenter = avg;\!r\!n\!t\!tIf ( center != oldcenter,\!r\!n\!t\!t\!trescaleAxis;\!r\!n\!t\!t\!toldcenter = center;\!r\!n\!t\!t,\!r\!n\!t\!t\!tIf ( statistic != oldstatistic,\!r\!n\!t\!t\!t\!tgb[AxisBox(2)]\!r\!n\!t\!t\!t\!t<<  Min( oldMin )\!r\!n\!t\!t\!t\!t<<  Max( oldMax )\!r\!n\!t\!t\!t\!t<<  Inc( oldInc );\!r\!n\!t\!t\!t,\!r\!n\!t\!t\!t\!tIf (flagfirstz,\!r\!n\!t\!t\!t\!t\!tgb[AxisBox(2)]\!r\!n\!t\!t\!t\!t\!t<<  Min( oldMin )\!r\!n\!t\!t\!t\!t\!t<<  Max( oldMax )\!r\!n\!t\!t\!t\!t\!t<<  Inc( oldInc );\!r\!n\!t\!t\!t\!t\!tflagfirstz = 0;\!r\!n\!t\!t\!t\!t)\!r\!n\!t\!t\!t);\!r\!n\!t\!t);\!t\!r\!n\!t\!tgb << Reshow;\!r\!n\!t\!tvlbInference[NumberColBox(1)] << Set Values( result );\!r\!n\!t);\!r\!n\!toldstatistic = statistic;\!r\!n);\!r\!n\!r\!nrescaleaxis = Expr(\!r\!n\!toldMin = center - 2 * q * result[2];\!r\!n\!toldMax = center + 2 * q * result[2];\!r\!n\!toldInc = result[1] * result[2];\!r\!n\!tgb[AxisBox(2)]\!r\!n\!t<<  Min( oldMin )\!r\!n\!t<<  Max( oldMax )\!r\!n\!t<<  Inc( oldInc )\!r\!n\!t<< Format( \!"Fixed Dec\!", 13, 2);\!r\!n);\!r\!n\!r\!n// user functions\!r\!ncalcNecessaryStatistics = Function( {dt},\!r\!n\!t{Default Local},\!r\!n\!tIf( Is Empty( dt ),\!r\!n\!t\!ttry(dt = Open());\!r\!n\!t\!tif (Is Empty( dt ),\!r\!n\!t\!t\!tNew Window( , modal,\!r\!n\!t\!t\!t\!tText Box(\!"No Data Table Selected. Script Terminating.\!")\!r\!n\!t\!t\!t);\!r\!n\!t\!t\!tstop;\!r\!n\!t\!t);\!r\!n\!t);\!r\!n\!tnc = N Col( dt );\!r\!n\!tIf( nc == 1,\!r\!n\!t\!tm = Column( 1 ) << get values,\!r\!n\!t\!tres = Column Dialog( c = ColList( \!"Pick a Numeric Column\!", Min Col (1), Max Col( 1 ), DataType(Numeric) ), );\!r\!n\!t\!tIf( res[\!"button\!"] == 1,\!r\!n\!t\!t\!tm = res[\!"c\!"][1] << get values\!r\!n\!t\!t,\!r\!n\!t\!t\!tNew Window(, modal,\!r\!n\!t\!t\!t\!tText Box(\!"No Column Selected. Script Terminating.\!");\!r\!n\!t\!t\!t);\!r\!n\!t\!t\!tstop();\!r\!n\!t\!t);\!r\!n\!t);\!r\!n\!tIf( Is List( m ), \!r\!n\!t\!t//Nominal Variable\!r\!n\!t\!tNewWindow( , modal,\!r\!n\!t\!t\!tTextBox(\!r\!n\!t\!t\!t\!t\!"Error: Column must be numeric. Please\!\!nuse another data table and try again.\!"\!r\!n\!t\!t\!t);\!r\!n\!t\!t);\!r\!n\!t\!tstop();\!r\!n\!t, \!r\!n\!t//Continuous Variable\!r\!n\!t\!tn = N Row( m );\!r\!n\!t\!tinList = {};\!r\!n\!t\!tFor( i = 1, i <= n, i++,\!r\!n\!t\!t\!tinList[i] = Char( m[i] )\!r\!n\!t\!t);\!r\!n\!t\!txnam = char(res[\!"c\!"][1]);\!r\!n\!t\!tnmiss = N Missing( m );\!r\!n\!t\!tn -= nmiss;\!r\!n\!t\!tavg = Mean( m );\!r\!n\!t\!ttmp = V Std( m );\!r\!n\!t\!tstd = tmp[1, 1];\!r\!n\!t\!tse = std / Sqrt( n );\!r\!n\!t);\!r\!n\!tEval List( {avg, std, n, se, m, xnam} );\!r\!n);\!r\!n\!r\!nuseParm = Function( { s, p, v },\!r\!n\!tIf( checkParm( s, p, v ),\!t\!t\!r\!n\!t\!tparmVal[s][p] = v;\!r\!n\!t\!tevalSummary,\!r\!n\!t\!tvlbSummary[TextEditBox(p)] << Set Text( Char( parmVal[s][p] ) );\!r\!n\!t);\!r\!n);\!r\!n\!r\!ncheckParm = Function( { s, p, v },\!r\!n\!tIf( Not( Is Missing( v ) ),\!r\!n\!t\!tChoose( s,\!r\!n\!t\!t\!t//  z\!r\!n\!t\!t\!tChoose( p,\!r\!n\!t\!t\!t\!t// Std Dev\!r\!n\!t\!t\!t\!tv > 0\!r\!n\!t\!t\!t)\!r\!n\!t\!t)\!r\!n\!t,\!r\!n\!t\!t0;\!r\!n\!t);\!r\!n);\!r\!n\!r\!nFixPlot = Expr(\!r\!n\!tgb[AxisBox(1)]\!r\!n\!t\!t<< Remove Axis Label\!r\!n\!t\!t<< Show Major Ticks( 0 )\!r\!n\!t\!t<< Show Labels( 0 )\!r\!n\!t\!t<< Show Minor Ticks( 0 );\!r\!n\!tgb[AxisBox(2)]\!r\!n\!t\!t<< Format( \!"Fixed Dec\!", 13