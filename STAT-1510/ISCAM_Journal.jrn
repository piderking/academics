OutlineBox(
open(1),title("Probability Distributions"),indent(13),default font id(2),sub(
ListBox(vertical,near,sub(
ButtonBox(title("Distribution Calculator"),scriptText("//!\!r\!n/*\!r\!ndistribution_calcs_combined_testing.jsl\!r\!n\!r\!n03 January 2012\!r\!n\!r\!nCopyright (c) 2012 by SAS Institute Inc., Cary, NC 27513, USA. All rights reserved.\!r\!n\!r\!nNote: Please read the disclaimer at the end of this script.\!r\!n\!r\!nPurpose\!r\!nThis script computes probabilities and critical values for a variety of continuous and discrete distributions.\!r\!n\!r\!nAuthor\!r\!nBrady Brady (SAS Institute)\!r\!n\!r\!n*/\!r\!n\!r\!n// switches, flags, parameters, values\!r\!n\!r\!nClear Globals();\!r\!nNames Default To Here( 1 );\!r\!nxhi# = 4;\!r\!nxlo# = -4;\!r\!npval# = .;\!r\!nprobOpts# = 1;\!r\!ncalctype# = 1;\!r\!n\!r\!n\!r\!n/*\!r\!n//load help list\!r\!ndt = datatable(\!"dist_info\!");\!r\!nhelp_list = {};\!r\!nfor (i = 1, i <= nrows(dt), i++,\!r\!n\!thelp_list = concat(help_list, evallist(list(column(dt, \!"Help Message\!")[i])) )\!r\!n);\!r\!n*/\!r\!n\!r\!n\!r\!n\!r\!n/*\!r\!n\!r\!nfor (i = 1, i<= nitems(help_list), i++,\!r\!n\!tnewwindow(char(i),\!r\!n\!t\!ttextbox(help_list[i])\!r\!n\!t)\!r\!n);\!r\!n\!r\!n*/\!r\!n\!r\!nhelp_list =\!r\!n{\!"Normal Distribution: \!r\!n \!r\!nParameters:\!r\!nMean can be any value. \!r\!nStd. Dev. must be > 0. \!r\!n \!r\!nCalculations:\!r\!nEnsure a <= b.\!r\!nEnsure 0 < Probability < 1.\!",\!r\!n\!"t Distribution: \!r\!n \!r\!nParameters:\!r\!nDF must be an integer > 0. \!r\!n \!r\!nCalculations:\!r\!nEnsure a <= b.\!r\!nEnsure 0 < Probability < 1.\!",\!r\!n\!"Chi-Square Distribution: \!r\!n \!r\!nParameters:\!r\!nDF must be an integer > 0.\!r\!nNon-Centrality must be >= 0. \!r\!n \!r\!nCalculations:\!r\!nEnsure 0 <= a <= b.\!r\!nEnsure 0 < Probability < 1.\!",\!r\!n\!"F Distribution: \!r\!n \!r\!nParameters:\!r\!nNum. and Denom. DF must integers > 0.\!r\!nNon-Centrality must be >= 0. \!r\!n \!r\!nCalculations:\!r\!nEnsure 0 <= a <= b.\!r\!nEnsure 0 < Probability < 1.\!",\!r\!n\!"Beta Distribution: \!r\!n \!r\!nParameters:\!r\!nAlpha and Beta must be > 0.\!r\!nThreshold can be any value.\!r\!nScale must be > 0.\!r\!n \!r\!nCalculations:\!r\!nEnusre Threshold <= a <= b <= Threshold + Scale.\!r\!nEnsure 0 < Probability < 1.\!",\!r\!n\!"Beta Binomial Distribution:\!r\!n\!r\!nParameters:\!r\!nP(Success) must be between 0 and 1.\!r\!nN must be an integer > 0.\!r\!nOverdispersion must be between 0 and 1, inclusive.\!r\!n\!r\!nNote: \!r\!nP = alpha/(alpha + beta)\!r\!nOverdispersion = 1/(alpha + beta + 1)\!r\!n\!r\!nCalculations:\!r\!nEnsure a and b are integers with a <= b.\!r\!nEnsure 0 < Probabilty < 1.\!",\!r\!n\!"Binomial Distribution:\!r\!n \!r\!nParameters:\!r\!nP(Success) must be between 0 and 1.\!r\!nN must be an integer > 0.\!r\!n \!r\!nCalculations:\!r\!nEnsure a and b are integers with a <= b.\!r\!nEnsure 0 < Probability < 1.\!",\!r\!n\!"Exponential Distribution:\!r\!n \!r\!nParameters:\!r\!nThreshold can be any number.\!r\!nScale must be > 0.\!r\!n \!r\!nCalculations:\!r\!nEnsure a <= b.\!r\!nEnsure 0 < Probability < 1.\!",\!r\!n\!"Frechet Distribution:\!r\!n\!r\!nParameters:\!r\!nLocation can be any number.\!r\!nShape and Scale must be > 0.\!r\!n\!r\!nCalculations:\!r\!nEnsure Location < a <= b.\!r\!nEnsure 0 < Probability < 1.\!",\!r\!n\!"Gamma Distribution:\!r\!n \!r\!nParameters:\!r\!nShape and Scale must be positive.\!r\!nThreshold can be any number.\!r\!n \!r\!nCalculations:\!r\!nEnsure Threshold <= a <= b.\!r\!nEnsure 0 < Probability < 1.\!",\!r\!n\!"Gamma Poisson Distribution:\!r\!n\!r\!nParameters:\!r\!nMean must be > 0.\!r\!nOverdispersion must be >= 1.\!r\!n\!r\!nCalculations:\!r\!nEnsure a and b are integers with a <= b.\!r\!nEnsure 0 < Probability < 1.\!",\!r\!n\!"Generalized Logarithmic Distribution:\!r\!n\!r\!nParameters:\!r\!nLocation can be any number.\!r\!nScale and Shape must be > 0.\!r\!n\!r\!nCalculations:\!r\!nEnsure a <= b.\!r\!nEnsure 0 < Probability < 1.\!",\!r\!n\!"Hypergeometric Distribution:\!r\!n \!r\!nParameters:\!r\!nPopulation Size, Number of Items and Sample Size must be positive integers, none greater than Number of Items.\!r\!n \!r\!nCalculations:\!r\!nEnsure a and b are integers with a <= b.\!r\!nEnsure 0 < Probability < 1.\!",\!r\!n\!"Johnson SB Distribution:\!r\!n\!r\!nParameters:\!r\!nShape 1 can be any value.\!r\!nShape 2 must be > 0.\!r\!nLocation can be any value.\!r\!nScale must be > 0.\!r\!n\!r\!nCalculations:\!r\!nEnsure a <= b.\!r\!nEnsure 0 < Probability < 1.\!",\!r\!n\!"Johnson SL Distribution:\!r\!n\!r\!nParameters:\!r\!nShape 1 can be any value.\!r\!nShape 2 must be > 0.\!r\!nLocation can be any value.\!r\!nScale must equal 1 or -1.\!r\!n\!r\!nCalculations:\!r\!nEnsure a <= b.\!r\!nEnsure 0 < Probability < 1.\!",\!r\!n\!"Johnson SU Distribution:\!r\!n\!r\!nParameters:\!r\!nShape 1 can be any value.\!r\!nShape 2 must be > 0.\!r\!nLocation can be any value.\!r\!nScale must be > 0.\!r\!n\!r\!nCalculations:\!r\!nEnsure a <= b.\!r\!nEnsure 0 < Probability < 1.\!",\!r\!n\!"Largest Extreme Value Distribution:\!r\!n\!r\!nParameters:\!r\!nLocation can be any number.\!r\!nScale must be > 0.\!r\!n\!r\!nCalculations:\!r\!nEnsure a <= b.\!r\!nEnsure 0 < Probability < 1.\!",\!r\!n\!"Logistic Distribution:\!r\!n\!r\!nParameters:\!r\!nLocation can be any number.\!r\!nScale must be > 0.\!r\!n\!r\!nCalculations:\!r\!nEnsure a <= b.\!r\!nEnsure 0 < Probability < 1.\!",\!r\!n\!"Loglogistic Distribution:\!r\!n\!r\!nParameters:\!r\!nLocation and scale must be > 0.\!r\!n\!r\!nCalculations:\!r\!nEnsure 0 < a <= b.\!r\!nEnsure 0 < Probability < 1.\!",\!r\!n\!"Lognormal Distribution:\!r\!n\!r\!nParameters:\!r\!nLocation can be any number.\!r\!nScale must be > 0.\!r\!n\!r\!nCalculations:\!r\!nEnsure 0 < a <= b.\!r\!nEnsure 0 < Probability < 1.\!",\!r\!n\!"Negative Binomial Distribution:\!r\!n \!r\!nParameters:\!r\!nP(Success) must be between 0 and 1.\!r\!nNumber of Successes must be an integer > 0.\!r\!n \!r\!nCalculations:\!r\!nEnsure a and b are integers with 0 <= a <= b.\!r\!nEnsure 0 < Probability < 1.\!",\!r\!n\!"Poisson Distribution:\!r\!n \!r\!nParameters:\!r\!nMean must be > 0.\!r\!n \!r\!nCalculations:\!r\!nEnsure a and b are integers with a <= b.\!r\!nEnsure 0 < Probability < 1.\!",\!r\!n\!"Smallest Extreme Value Distribution:\!r\!n\!r\!nParameters:\!r\!nLocation can be any number.\!r\!nScale must be > 0.\!r\!n\!r\!nCalculations:\!r\!nEnsure a <= b.\!r\!nEnsure 0 < Probability < 1.\!",\!r\!n\!"Triangular Distribution:\!r\!n\!r\!nParameters:\!r\!nEnsure Left <= Inter <= Right, with Left < Right.\!r\!n\!r\!nCalculations:\!r\!nEnsure a <= b.\!r\!nEnsure 0 < Probability < 1.\!",\!r\!n\!"Uniform Distribution:\!r\!n \!r\!nParameters:\!r\!nEnsure Lower Limit < Upper Limit.\!r\!n \!r\!nCalculations:\!r\!nEnsure a <= b.\!r\!nEnsure 0 < Probability < 1.\!",\!r\!n\!"Weibull Distribution:\!r\!n \!r\!nParameters:\!r\!nShape and Scale must be > 0.\!r\!nThreshold can be any number.\!r\!n \!r\!nCalculations:\!r\!nEnsure a <= b.\!r\!nEnsure 0 < Probability < 1.\!"\!r\!n};\!r\!n\!r\!n\!r\!n//load distribution names\!r\!n\!r\!n/*\!r\!n\!r\!ndistnames# = {};\!r\!nfor (i = 1, i <= nrows(dt), i++,\!r\!n\!tl_in = {};\!r\!n\!tfor (j=2, j<=4, j++,\!r\!n\!t\!tl_in = concat(l_in, evallist(list(column(dt, j)[i])));\!r\!n\!t);\!r\!n\!tdistnames# = concat(distnames#, evallist(list(l_in)));\!r\!n);\!r\!n\!r\!n\!r\!n*/\!r\!n\!r\!ndistNames# = {{\!"Normal Density\!", \!"Normal Quantile\!", \!"Normal Distribution\!"}, {\!"t Density\!", \!"t Quantile\!", \!"t  Distribution\!"}, {\!"Chisquare Density\!",\!r\!n\!"Chisquare Quantile\!", \!"Chisquare Distribution\!"}, {\!"F Density\!", \!"F Quantile\!", \!"F Distribution\!"}, {\!"Beta Density\!", \!"Beta Quantile\!", \!"Beta Distribution\!"\!r\!n}, {\!"Beta_Binomial_Probability\!", \!"Beta_Binomial_Quantile\!", \!"Beta_Binomial_Distribution\!"}, {\!"Binomial Probability\!", \!"Binomial Quantile\!",\!r\!n\!"Binomial Distribution\!"}, {\!"Exponential_Density\!", \!"Exponential_Quantile\!", \!"Exponential_Distribution\!"}, {\!"Frechet_Density\!", \!"Frechet_Quantile\!",\!r\!n\!"Frechet_Distribution\!"}, {\!"Gamma Density\!", \!"Gamma Quantile\!", \!"Gamma Distribution\!"}, {\!"Gamma_Poisson_Probability\!", \!"Gamma_Poisson_Quantile\!",\!r\!n\!"Gamma_Poisson_Distribution\!"}, {\!"Glog Density\!", \!"Glog Quantile\!", \!"Glog Distribution\!"}, {\!"Hypergeometric_Probability\!", \!"Hypergeometric_Quantile\!",\!r\!n\!"Hypergeometric_Distribution\!"}, {\!"Johnson SB Density\!", \!"Johnson SB Quantile\!", \!"Johnson SB Distribution\!"}, {\!"Johnson SL Density\!",\!r\!n\!"Johnson SL Quantile\!", \!"Johnson SL Distribution\!"}, {\!"Johnson SU Density\!", \!"Johnson SU Quantile\!", \!"Johnson SU Distribution\!"}, {\!"LEV Density\!",\!r\!n\!"LEV Quantile\!", \!"LEV Distribution\!"}, {\!"Logistic Density\!", \!"Logistic Quantile\!", \!"Logistic Distribution\!"}, {\!"Loglogistic_Density\!",\!r\!n\!"Loglogistic_Quantile\!", \!"Loglogistic_Distribution\!"}, {\!"Lognormal Density\!", \!"Lognormal Quantile\!", \!"Lognormal Distribution\!"},\!r\!n{\!"NegBinomial_Probability\!", \!"NegBinomial_Quantile\!", \!"NegBinomial_Distribution\!"}, {\!"Poisson Probability\!", \!"Poisson Quantile\!", \!"Poisson Distribution\!"},\!r\!n{\!"SEV Density\!", \!"SEV Quantile\!", \!"SEV Distribution\!"}, {\!"Triangular_Density\!", \!"Triangular_Quantile\!", \!"Triangular_Distribution\!"}, {\!"Uniform_Density\!",\!r\!n\!"Uniform_Quantile\!", \!"Uniform_Distribution\!"}, {\!"Weibull Density\!", \!"Weibull Quantile\!", \!"Weibull Distribution\!"}};\!r\!n\!r\!n// Load distribution list\!r\!n\!r\!n/*\!r\!n\!r\!ndistList = {};\!r\!nfor (i = 1, i <= nrows(dt), i++,\!r\!n\!t\!tdistList = concat(distList, evallist(list(column(dt, 2)[i])));\!r\!n);\!r\!n\!r\!n*/\!r\!n\!r\!ndistList# = {\!"Normal\!", \!"t\!", \!"Chi Square\!", \!"F\!", \!"Beta\!", \!"Beta Binomial\!", \!"Binomial\!", \!"Exponential\!", \!"Frechet\!", \!"Gamma\!", \!"Gamma Poisson\!",\!r\!n\!"Generalized Logarithmic\!", \!"Hypergeometric\!", \!"Johnson SB\!", \!"Johnson SL\!", \!"Johnson SU\!", \!"Largest Extreme Value\!", \!"Logistic\!", \!"Loglogistic\!",\!r\!n\!"Lognormal\!", \!"Negative Binomial\!", \!"Poisson\!", \!"Smallest Extreme Value\!", \!"Triangular\!", \!"Uniform\!", \!"Weibull\!"};\!r\!n\!r\!n\!r\!n//Load Parameter Strings \!r\!n\!r\!n/*\!r\!ndt = datatable(\!"dist_info\!");\!r\!ndt << new column(\!"arg2\!", formula(substitute(Arguments, \!"\!\!\!"\!", \!"\!", \!" \!", \!"^\!"))); //else may lose trailing spaces on last argument\!r\!nparm_list = {};\!r\!nfor (i = 1, i <= nrows(dt), i++,\!r\!n\!tparm_list = concat(parm_list, evallist(list(words(column(dt, \!"arg2\!")[i], \!",\!") ) ) )\!r\!n);\!r\!nfor(i = 1, i <= nitems(parm_list), i++,\!r\!n\!tfor (j = 1, j <= nitems(parm_list[i]), j++,\!r\!n\!t\!tparm_list[i][j] = substitute(parm_list[i][j], \!"^\!", \!" \!")\!r\!n\!t);\!r\!n);\!r\!ndt << delete columns(arg2);\!r\!n*/\!r\!n\!r\!nparmStr = {{\!"Mean\!", \!"Std. Dev.  \!"}, {\!"DF  \!"}, {\!"DF\!", \!"Non-centrality  \!"}, {\!"Numerator DF\!", \!"Denominator DF  \!", \!"Non-centrality  \!"}, {\!"Alpha\!", \!"Beta\!",\!r\!n\!"Threshold  \!", \!"Scale\!"}, {\!"P(Success)\!", \!"n\!", \!"Overdispersion  \!"}, {\!"P(Success)\!", \!"n\!"}, {\!"Threshold  \!", \!"Scale\!"}, {\!"Location  \!", \!"Shape\!", \!"Scale\!"},\!r\!n{\!"Shape\!", \!"Scale\!", \!"Threshold  \!"}, {\!"Mean\!", \!"Overdispersion  \!"}, {\!"Location  \!", \!"Scale\!", \!"Shape\!"}, {\!"Population Size  \!", \!"Number of Items\!",\!r\!n\!"Sample Size\!"}, {\!"Shape 1\!", \!"Shape 2\!", \!"Location  \!", \!"Scale\!"}, {\!"Shape 1\!", \!"Shape 2\!", \!"Location  \!", \!"Skew\!"}, {\!"Shape 1\!", \!"Shape 2\!", \!"Location  \!",\!r\!n\!"Scale\!"}, {\!"Location  \!", \!"Scale\!"}, {\!"Location  \!", \!"Scale\!"}, {\!"Location  \!", \!"Scale\!"}, {\!"Location  \!", \!"Scale\!"}, {\!"P(Success)  \!",\!r\!n\!"Number of successes:  \!"}, {\!"Mean  \!"}, {\!"Location  \!", \!"Scale\!"}, {\!"Left\!", \!"Inter\!", \!"Right  \!"}, {\!"Lower Limit\!", \!"Upper Limit  \!"}, {\!"Shape\!", \!"Scale\!",\!r\!n\!"Threshold  \!"}};\!r\!n\!r\!n/*\!r\!ndt = datatable(\!"dist_info\!");\!r\!ndefaults# = {};\!r\!nfor (i = 1, i <= nrows(dt), i++,\!r\!n\!tdefaults# = concat(defaults#, evallist(list(parse(column(dt, \!"Defaults\!")[i] ) ) ) ) ;\!r\!n);\!r\!n\!r\!n\!r\!n*/\!r\!n\!r\!norigParmVal = parmVal = {[0 1], [10], [4 0], [5 20 0], [2 7 0 3], [0.5 10 0], [0.5 5], [0 1], [0 2 1], [2 1 0], [4 1], [0 0.5 2], [20 5 10], [1 1 0 3\!r\!n], [1 2 0 1], [1 2 1 1], [0 1], [0 1], [1 4], [1 .5], [0.5 3], [4], [1 1], [0 1 3], [0 10], [3 1 0]};\!r\!n\!r\!nInputVal = {};\!r\!nFor( i = 1, i <= N Items( parmStr ), i++,\!r\!n\!tInputVal = Inputval || {{[1 1], [.5]}}\!r\!n);\!r\!nOrigInputVal = InputVal;\!r\!n\!r\!nOptionStr = List(\!r\!n\!tList( \!" X <= Qa (lower tail)\!", \!" X > Qa (upper tail)\!", \!" Qa < X <= Qb (between)\!", \!" X <= Qa   or   X > Qb  (outside)\!" ),\!r\!n\!tList( \!"Left tail probability\!", \!"Right tail probability\!", \!"Central probability\!", \!"2-tail probability\!" )\!r\!n);\!r\!n\!r\!n// macros\!r\!n\!r\!nchangeDist = Expr(\!r\!n\!tvlbParams << Delete;\!r\!n\!tlineUpBoxExpr = Expr( Lineup Box( N Col( 2 ) ) );\!r\!n\!tdiscreteflag = (Contains( distnames#[distribution#][1], \!"Probability\!" ));\!r\!n\!tnDistParms = N Items( ParmStr[distribution#] );\!r\!n\!t\!r\!n\!tFor( i = 1, i <= nDistParms, i++,\!r\!n\!t\!tInsert Into( lineUpBoxExpr, Parse( Substitute( \!"Text Box( parmStr[distribution#][iii] )\!", \!"iii\!", Char( i ) ) ) );\!r\!n\!t\!tInsert Into(\!r\!n\!t\!t\!tlineUpBoxExpr,\!r\!n\!t\!t\!tParse(\!r\!n\!t\!t\!t\!tSubstitute(\!r\!n\!t\!t\!t\!t\!t\!t\!"tebiii = Text Edit Box( parmVal[distribution#][iii],\!r\!n\!t\!t\!t\!t\!t\!t<< Script(\!r\!n\!t\!t\!t\!t\!t\!t\!tuseParm(\!r\!n\!t\!t\!t\!t\!t\!t\!t\!tdistribution#,\!r\!n\!t\!t\!t\!t\!t\!t\!t\!tiii,\!r\!n\!t\!t\!t\!t\!t\!t\!t\!tNum( tebiii << Get Text )\!r\!n\!t\!t\!t\!t\!t\!t\!t);\!r\!n\!t\!t\!t\!t\!t\!t)\!r\!n\!t\!t\!t\!t\!t)\!",\!r\!n\!t\!t\!t\!t\!t\!"iii\!", Char( i )\!r\!n\!t\!t\!t\!t)\!r\!n\!t\!t\!t)\!r\!n\!t\!t);