\!n\!tsummarytext = {\!"Sample 1 Count\!", \!"Sample 1 Size\!", \!"Sample 2 Count\!", \!"Sample 2 Size\!"};\!r\!n\!tstats = J(nitems(summarytext), 1, .);\!r\!n\!tresulttext = {\!"Sample Proportion 1\!", \!"Standard Error 1\!", \!"Sample Proportion 2\!", \!"Standard Error 2\!", \!"Difference in Proportions (p2 - p1)\!", \!"Standard Error (p2 - p1)\!", \!"Z quantile\!", \!"Lower Limit\!", \!"Upper Limit\!"};\!r\!n\!tresult = J(9,1,.);\!r\!n\!t);\!r\!n\!tinitVars;\!r\!n\!r\!n\!tcalcNecessaryStatistics = Function( {dt},\!r\!n\!t\!t{Default Local},\!r\!n\!t\!tIf( Is Empty( dt ),\!r\!n\!t\!t\!tTry( dt = Open() );\!r\!n\!t\!t\!tIf( Is Empty( dt ),\!r\!n\!t\!t\!t\!tNew Window( ,\!r\!n\!t\!t\!t\!t\!tmodal,\!r\!n\!t\!t\!t\!t\!tText Box( \!r\!n\!t\!t\!t\!t\!t\!t\!"No Data Table Selected. Script Terminating.\!" \!r\!n\!t\!t\!t\!t\!t)\!r\!n\!t\!t\!t\!t);\!r\!n\!t\!t\!t\!tstop();\!r\!n\!t\!t\!t);\!r\!n\!t\!t);\!r\!n\!t\!trs = (dt << get row states);\!r\!n\!t\!tnc = N Col( dt );\!r\!n\!t\!tIf( nc == 1,\!r\!n\!t\!t\!tm = Column( 1 ) << get values;\!r\!n\!t\!t\!tres = Dialog( \!"\!", HList( \!"Value Associated with a Success\!", ex = EditText( \!"Success\!" ) ) );\!r\!n\!t\!t\!tIf( res[\!"button\!"] == 1,\!r\!n\!t\!t\!t\!tsuccessString = res[\!"ex\!"],\!r\!n\!t\!t\!t\!tm = J( 0, 0, 0 )\!r\!n\!t\!t\!t);\!r\!n\!t\!t,\!r\!n\!t\!t\!tres = Column Dialog(\!r\!n\!t\!t\!t\!tc1 = ColList( \!"Pick a Column Containing the Names of the 2 Groups\!", Max Col( 1 ), Min Col(1) ),\!r\!n\!t\!t\!t\!tc2 = ColList( \!"Pick a Column Containing the Result of Each Individual Trial\!", Max Col( 1 ), Min Col(1) ),\!r\!n\!t\!t\!t\!tHList( \!"Enter the Value Associated with a Success\!", ex = EditText( \!"Success\!" ) )\!r\!n\!t\!t\!t);\!r\!n\!t\!t\!tIf( res[\!"button\!"] == 1,\!r\!n\!t\!t\!t\!tm = res[\!"c2\!"][1] << get values;\!r\!n\!t\!t\!t\!tsuccessString = res[\!"ex\!"];\!r\!n\!t\!t\!t,\!r\!n\!t\!t\!t\!tNew Window( , modal,\!r\!n\!t\!t\!t\!t\!tText Box(\!"No Column Selected. Script Terminating.\!")\!r\!n